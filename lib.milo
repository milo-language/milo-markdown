// markdown — a CommonMark 0.31.2 + GFM parser and HTML renderer for Milo.
//
// A document parses into a flat node pool. Every handle is an `i64` index into
// that pool and **-1 means "not there"**, so a walk that misses is not an error,
// it is a handle that reads as absent — the same shape `std/json` and the `yaml`
// package use, and the reason there is no `Option` at every step of a walk.
//
// The pool (rather than a recursive enum) is deliberate: Milo has no pointers in
// safe code, so a self-referential value type would need an arena anyway — and
// indices make the whole document one contiguous, cheaply-cloned value.
//
// The tree is the product, not the HTML. `toHtml` is one consumer of it: a docs
// generator pulls `Heading` nodes out of the same tree, and a link checker walks
// `Link`/`Image` nodes for their `dest`. Rendering is a fold over the tree, so
// anything the renderer can see, a caller can see too.
//
// The parse is a port of the CommonMark reference algorithm (commonmark.js):
// a line-at-a-time block phase that keeps a stack of open containers, then an
// inline phase per leaf block that uses the delimiter-stack algorithm for
// emphasis and the bracket stack for links. Regexes are hand-rolled scanners —
// this package pulls in nothing but the standard library.

from "std/unicode" import {
    decodeCodepoint, encodeCodepoint
}

// ── Public node kinds ────────────────────────────────────────────────────────

// The integer repr is the pool's storage; the variant names are the public
// spelling. Blocks sort below `Text` so `isBlock` is a range check.
pub enum NodeKind: i32 {
    Document, // 0
    BlockQuote, // 1
    List, // 2
    Item, // 3
    CodeBlock, // 4
    HtmlBlock, // 5
    Paragraph, // 6
    Heading, // 7
    ThematicBreak, // 8
    Table, // 9  — GFM
    TableRow, // 10 — GFM
    TableCell, // 11 — GFM
    Text, // 12
    SoftBreak, // 13
    LineBreak, // 14
    Code, // 15
    HtmlInline, // 16
    Emph, // 17
    Strong, // 18
    Strike, // 19 — GFM
    Link, // 20
    Image, // 21
    Missing, // 22 — only an accessor returns it, for an invalid handle
}

// Cell alignment for a GFM table column.
pub enum Align: i32 {
    None, // 0
    Left, // 1
    Center, // 2
    Right, // 3
}

// One node. Strings live inline rather than in a side pool: a markdown node's
// literal is its payload (not a shared key), so interning would buy nothing and
// cost a second index space to get wrong.
pub struct MdNode {
    kind: NodeKind,
    literal: string, // Text/Code/Html literal, CodeBlock body
    dest: string, // Link/Image destination; CodeBlock info string
    title: string, // Link/Image title
    content: string, // parse-time line accumulator; empty once finalized

    level: i64, // Heading level; TableCell alignment; List start number
    listOrdered: bool,
    listTight: bool,
    listDelim: u8, // '-' '*' '+' for bullets, '.' or ')' for ordered
    listPadding: i64,
    listMarkerOffset: i64,
    taskState: i64, // Item: 0 none, 1 unchecked, 2 checked (GFM)
    isFenced: bool,
    fenceChar: u8,
    fenceLen: i64,
    fenceOffset: i64,
    htmlBlockType: i64,
    isHeader: bool, // TableRow/TableCell inside <thead>

    // Parse-time tree links (a doubly-linked child list, which the emphasis
    // algorithm needs for its unlink/insertAfter dance), flattened into
    // childStart/childCount once parsing is done.
    firstChild: i64,
    lastChild: i64,
    next: i64,
    prev: i64,
    parent: i64,
    open: bool,
    lastLineBlank: bool,

    childStart: i64, // offset into Markdown.childIdx
    childCount: i64,
}

fn mdNode(kind: NodeKind): MdNode {
    return MdNode {
        kind: kind,
        literal: "",
        dest: "",
        title: "",
        content: "",
        level: 0,
        listOrdered: false,
        listTight: true,
        listDelim: 0,
        listPadding: 0,
        listMarkerOffset: 0,
        taskState: 0,
        isFenced: false,
        fenceChar: 0,
        fenceLen: 0,
        fenceOffset: 0,
        htmlBlockType: 0,
        isHeader: false,
        firstChild: -1,
        lastChild: -1,
        next: -1,
        prev: -1,
        parent: -1,
        open: true,
        lastLineBlank: false,
        childStart: 0,
        childCount: 0,
    }
}

// A parsed document: the node pool, the flattened child index, and the root.
pub struct Markdown {
    nodes: Vec<MdNode>,
    childIdx: Vec<i64>,
    root: i64,
}

// The headline API: markdown in, HTML out.
pub fn mdToHtml(src: &string): string {
    let doc = Markdown.parse(src.clone())
    return doc.toHtml()
}

impl Markdown {
    // Parse a document. There is no error case — CommonMark has no invalid
    // input, only input that renders as text.
    fn parse(src: string): Markdown {
        var p = MdParser.new()
        p.parseAll(src)
        var m = Markdown {
            nodes: p.nodes, childIdx: Vec.new(), root: p.doc
        }
        m.flatten()
        return m
    }

    // Turn the parse-time linked child lists into contiguous ranges of
    // `childIdx`, so `at(i)` is a lookup rather than a walk. Nodes orphaned
    // during parsing (an unlinked paragraph, a consumed emphasis delimiter) stay
    // in the pool but are unreachable from the root.
    fn flatten(self: &mut Self): void {
        let count = self.nodes.len
        for i in 0..count {
            let start = self.childIdx.len
            var c = self.nodes[i].firstChild
            var n: i64 = 0
            while c >= 0 {
                self.childIdx.push(c)
                n = n + 1
                c = self.nodes[c].next
            }
            self.nodes[i].childStart = start
            self.nodes[i].childCount = n
        }
    }

    // ── Tree access, in std/json's vocabulary ────────────────────────────────

    fn root(self: &Self): i64 {
        return self.root
    }

    // Number of children of `node`; 0 for a leaf or a missing handle.
    fn len(self: &Self, node: i64): i64 {
        if node < 0 || node >= self.nodes.len {
            return 0
        }
        return self.nodes[node].childCount
    }

    // i-th child of `node`, or -1.
    fn at(self: &Self, node: i64, i: i64): i64 {
        if node < 0 || node >= self.nodes.len {
            return -1
        }
        if i < 0 || i >= self.nodes[node].childCount {
            return -1
        }
        return self.childIdx[self.nodes[node].childStart + i]
    }

    fn kind(self: &Self, node: i64): NodeKind {
        if node < 0 || node >= self.nodes.len {
            return NodeKind.Missing
        }
        return self.nodes[node].kind
    }

    fn exists(self: &Self, node: i64): bool {
        return node >= 0 && node < self.nodes.len
    }

    fn parent(self: &Self, node: i64): i64 {
        if node < 0 || node >= self.nodes.len {
            return -1
        }
        return self.nodes[node].parent
    }

    // Literal payload: text, code-span/code-block body, raw HTML. "" elsewhere.
    fn text(self: &Self, node: i64): string {
        if node < 0 || node >= self.nodes.len {
            return ""
        }
        return self.nodes[node].literal.clone()
    }

    // Link/Image destination, or a code block's info string.
    fn dest(self: &Self, node: i64): string {
        if node < 0 || node >= self.nodes.len {
            return ""
        }
        return self.nodes[node].dest.clone()
    }

    fn title(self: &Self, node: i64): string {
        if node < 0 || node >= self.nodes.len {
            return ""
        }
        return self.nodes[node].title.clone()
    }

    // A fenced code block's info string -- "rust" for a rust-tagged fence.
    fn info(self: &Self, node: i64): string {
        return self.dest(node)
    }

    // Heading level (1-6), a list's start number, or a table cell's alignment.
    fn level(self: &Self, node: i64): i64 {
        if node < 0 || node >= self.nodes.len {
            return 0
        }
        return self.nodes[node].level
    }

    fn align(self: &Self, node: i64): Align {
        if node < 0 || node >= self.nodes.len {
            return Align.None
        }
        if self.nodes[node].kind as i32 != NodeKind.TableCell as i32 {
            return Align.None
        }
        let a = self.nodes[node].level
        if a == 1 {
            return Align.Left
        }
        if a == 2 {
            return Align.Center
        }
        if a == 3 {
            return Align.Right
        }
        return Align.None
    }

    fn isOrdered(self: &Self, node: i64): bool {
        if node < 0 || node >= self.nodes.len {
            return false
        }
        return self.nodes[node].listOrdered
    }

    fn isTight(self: &Self, node: i64): bool {
        if node < 0 || node >= self.nodes.len {
            return false
        }
        return self.nodes[node].listTight
    }

    // GFM task list items: `- [ ] a` / `- [x] a`.
    fn isTask(self: &Self, node: i64): bool {
        if node < 0 || node >= self.nodes.len {
            return false
        }
        return self.nodes[node].taskState != 0
    }

    fn isChecked(self: &Self, node: i64): bool {
        if node < 0 || node >= self.nodes.len {
            return false
        }
        return self.nodes[node].taskState == 2
    }

    // Every descendant's text content, concatenated — the plain-text rendering
    // of a subtree. This is what a docs generator wants out of a Heading and
    // what the renderer uses for an image's alt text.
    fn innerText(self: &Self, node: i64): string {
        var out = ""
        self.innerTextInto(node, out)
        return out
    }

    fn innerTextInto(self: &Self, node: i64, out: &mut string): void {
        if node < 0 || node >= self.nodes.len {
            return
        }
        let k = self.nodes[node].kind as i32
        // Raw inline HTML counts as text here, and the caller escapes it. That
        // is cmark's behaviour and the safe one: dropping it would silently
        // lose content, and passing it through unescaped would put attacker
        // markup inside an `alt` attribute.
        if k == NodeKind.Text as i32 || k == NodeKind.Code as i32 || k == NodeKind.HtmlInline as i32 {
            out.pushStr(self.nodes[node].literal)
        } else if k == NodeKind.SoftBreak as i32 || k == NodeKind.LineBreak as i32 {
            out.push('\n')
        }
        for i in 0..self.nodes[node].childCount {
            self.innerTextInto(self.childIdx[self.nodes[node].childStart + i], out)
        }
    }
}

// ── Byte and character classification ────────────────────────────────────────
//
// The block scanners work on bytes: every character CommonMark gives structural
// meaning to is ASCII, and a multi-byte sequence can never collide with one
// because UTF-8 continuation bytes are all >= 0x80. The inline flanking rules
// are the exception — they are specified over Unicode classes — so those decode
// codepoints (see `classifyBefore`/`classifyAfter`).
//
// `byteAt` returns 0 past the end of the string. NUL is replaced with U+FFFD
// before parsing starts (the spec requires it), so 0 unambiguously means "end".

fn byteAt(s: &string, i: i64): u8 {
    if i < 0 || i >= s.len {
        return 0
    }
    return s[i]
}

fn isSpaceOrTab(c: u8): bool {
    return c == ' ' || c == '\t'
}

fn isLineEnd(c: u8): bool {
    return c == 0 || c == '\n'
}

fn isDigitByte(c: u8): bool {
    return c >= '0' && c <= '9'
}

fn isAlphaByte(c: u8): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn isAlnumByte(c: u8): bool {
    return isAlphaByte(c) || isDigitByte(c)
}

fn isHexByte(c: u8): bool {
    return isDigitByte(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

fn lowerByte(c: u8): u8 {
    if c >= 'A' && c <= 'Z' {
        return c + 32
    }
    return c
}

// The 32 ASCII punctuation characters, which are exactly the ones a backslash
// may escape.
fn isAsciiPunct(c: u8): bool {
    if c >= '!' && c <= '/' {
        return true
    }
    if c >= ':' && c <= '@' {
        return true
    }
    if c >= '[' && c <= '`' {
        return true
    }
    if c >= '{' && c <= '~' {
        return true
    }
    return false
}

// A blank line is one with nothing but spaces and tabs.
fn isBlankStr(s: &string): bool {
    for c in s {
        if c != ' ' && c != '\t' && c != '\n' && c != '\r' {
            return false
        }
    }
    return true
}

fn toLowerStr(s: &string): string {
    var out = ""
    for c in s {
        out.push(lowerByte(c))
    }
    return out
}

// ── Unicode classes for the emphasis flanking rules ─────────────────────────
//
// The spec defines left/right-flanking over *Unicode* whitespace and
// punctuation, so a byte test is not enough: `*"héllo"*` and the CJK examples
// hinge on the class of a non-ASCII codepoint. This covers the classes the
// spec's own examples exercise plus the common ranges; it is not a full Unicode
// character database, and a codepoint outside these ranges classifies as
// "other", which is the same answer a letter would get.

fn isUnicodeWhitespaceCp(cp: i32): bool {
    if cp == 32 || cp == 9 || cp == 10 || cp == 12 || cp == 13 {
        return true
    }
    if cp == 160 {
        return true
    } // NBSP
    if cp == 5760 {
        return true
    } // OGHAM SPACE MARK
    if cp >= 8192 && cp <= 8202 {
        return true
    } // EN QUAD .. HAIR SPACE
    if cp == 8232 || cp == 8233 {
        return true
    } // LINE/PARAGRAPH SEPARATOR
    if cp == 8239 || cp == 8287 || cp == 12288 {
        return true
    }
    return false
}

// The Unicode currency symbols (category Sc). The spec counts every Symbol
// category as punctuation for flanking, and currency signs are the ones that
// turn up in front of emphasis in real text.
fn isCurrencySymbolCp(cp: i32): bool {
    if cp == 36 || cp == 1423 || cp == 1547 || cp == 2555 || cp == 2801 {
        return true
    }
    if cp >= 162 && cp <= 165 {
        return true
    }
    if cp >= 2046 && cp <= 2047 {
        return true
    }
    if cp >= 2546 && cp <= 2547 {
        return true
    }
    if cp == 3065 || cp == 3647 || cp == 6107 || cp == 43064 {
        return true
    }
    if cp >= 8352 && cp <= 8399 {
        return true
    }
    if cp == 65020 || cp == 65129 || cp == 65284 {
        return true
    }
    if cp >= 65504 && cp <= 65505 {
        return true
    }
    if cp >= 65509 && cp <= 65510 {
        return true
    }
    if cp >= 73693 && cp <= 73696 {
        return true
    }
    if cp == 123647 || cp == 126128 {
        return true
    }
    return false
}

fn isUnicodePunctCp(cp: i32): bool {
    if cp < 128 {
        return isAsciiPunct(cp as u8)
    }
    if isCurrencySymbolCp(cp) {
        return true
    }
    if cp >= 161 && cp <= 191 {
        // Latin-1 punctuation and symbols (inverted marks, guillemets, etc.).
        // The spec counts the Symbol categories here too since 0.30.
        return true
    }
    if cp == 215 || cp == 247 {
        return true
    }
    if cp >= 8192 && cp <= 8303 {
        return true
    } // General Punctuation
    if cp >= 8352 && cp <= 8399 {
        return true
    } // Currency Symbols
    if cp >= 8592 && cp <= 9215 {
        return true
    } // Arrows .. Misc Technical
    if cp >= 9312 && cp <= 11263 {
        return true
    } // Enclosed .. Misc Symbols
    if cp >= 11776 && cp <= 11903 {
        return true
    } // Supplemental Punctuation
    if cp >= 12289 && cp <= 12351 {
        return true
    } // CJK Symbols and Punctuation
    if cp >= 65072 && cp <= 65103 {
        return true
    } // CJK Compatibility Forms
    if cp >= 65281 && cp <= 65295 {
        return true
    } // Fullwidth ASCII punctuation
    if cp >= 65306 && cp <= 65312 {
        return true
    }
    if cp >= 65339 && cp <= 65344 {
        return true
    }
    if cp >= 65371 && cp <= 65381 {
        return true
    }
    return false
}

// ── HTML output escaping ─────────────────────────────────────────────────────
//
// Escaping is the security boundary of this package: everything below renders
// attacker-controlled text into a document. `escapeHtml` covers element text and
// quoted attribute values (`&`, `<`, `>`, `"` — matching cmark, which leaves `'`
// alone because it never emits a single-quoted attribute). `escapeHref`
// percent-encodes everything a URL may not carry literally, which is what stops
// a destination from closing the attribute and opening a tag.
//
// Neither function makes raw HTML safe. A `HtmlBlock`/`HtmlInline` node's
// literal is emitted verbatim, exactly as CommonMark specifies — if you render
// untrusted markdown, filter those nodes (they are visible in the tree) or run
// the output through a sanitizer.

pub fn escapeHtml(s: &string): string {
    var out = ""
    escapeHtmlInto(s, out)
    return out
}

fn escapeHtmlInto(s: &string, out: &mut string): void {
    for c in s {
        if c == '&' {
            out.pushStr("&amp;")
        } else if c == '<' {
            out.pushStr("&lt;")
        } else if c == '>' {
            out.pushStr("&gt;")
        } else if c == '"' {
            out.pushStr("&quot;")
        } else {
            out.push(c)
        }
    }
}

fn hexDigitUpper(v: i64): u8 {
    if v < 10 {
        return ('0' as i64 + v) as u8
    }
    return ('A' as i64 + (v - 10)) as u8
}

// Percent-encode a URL for an href/src attribute. The safe set is cmark's:
// alphanumerics plus `!#$%()*+,-./:;=?@_~`. `%` passes through so an
// already-encoded `%20` is not double-encoded (cmark does the same, and copies
// even a malformed `%zz` through). `&` and `'` come out as character references
// because the result lands inside a double-quoted attribute.
fn escapeHref(s: &string, out: &mut string): void {
    for c in s {
        if isAlnumByte(c) {
            out.push(c)
            continue
        }
        if c == '!' || c == '#' || c == '$' || c == '%' || c == '(' || c == ')'
        || c == '*' || c == '+' || c == ',' || c == '-' || c == '.' || c == '/'
        || c == ':' || c == ';' || c == '=' || c == '?' || c == '@' || c == '_'
        || c == '~' {
            out.push(c)
            continue
        }
        if c == '&' {
            out.pushStr("&amp;")
            continue
        }
        if c == '\'' {
            out.pushStr("&#x27;")
            continue
        }
        out.push('%')
        out.push(hexDigitUpper((c as i64) / 16))
        out.push(hexDigitUpper((c as i64) % 16))
    }
}

// ── Raw-HTML scanners (shared by html blocks and inline html) ────────────────

// The HTML block tag list from the spec's condition 6, and condition 1's four
// literal-text elements. A `|name|` membership test beats a Vec of strings here:
// it allocates nothing per call and the list is fixed by the spec.
fn isHtmlBlockTag(name: &string): bool {
    let tags = "|address|article|aside|base|basefont|blockquote|body|caption|center|col|colgroup|dd|details|dialog|dir|div|dl|dt|fieldset|figcaption|figure|footer|form|frame|frameset|h1|h2|h3|h4|h5|h6|head|header|hr|html|iframe|legend|li|link|main|menu|menuitem|nav|noframes|ol|optgroup|option|p|param|search|section|summary|table|tbody|td|tfoot|th|thead|title|tr|track|ul|"
    let probe = "|" + toLowerStr(name) + "|"
    return tags.contains(probe)
}

fn isRawTextTag(name: &string): bool {
    let lower = toLowerStr(name)
    return lower == "script" || lower == "pre" || lower == "style" || lower == "textarea"
}

// Length of an HTML tag name starting at `at`, or 0.
fn scanTagName(s: &string, at: i64): i64 {
    if !isAlphaByte(byteAt(s, at)) {
        return 0
    }
    var i = at + 1
    while i < s.len {
        let c = s[i]
        if isAlnumByte(c) || c == '-' {
            i = i + 1
        } else {
            break
        }
    }
    return i - at
}

fn isHtmlSpace(c: u8): bool {
    return c == ' ' || c == '\t' || c == '\n'
}

fn skipHtmlSpace(s: &string, at: i64): i64 {
    var i = at
    while i < s.len && isHtmlSpace(s[i]) {
        i = i + 1
    }
    return i
}

// Index just past `<name attr…>` at `start`, or -1.
fn scanOpenTag(s: &string, start: i64): i64 {
    if byteAt(s, start) != '<' {
        return -1
    }
    let nameLen = scanTagName(s, start + 1)
    if nameLen == 0 {
        return -1
    }
    var i = start + 1 + nameLen
    // attributes
    while true {
        let afterSpace = skipHtmlSpace(s, i)
        if afterSpace == i {
            break
        }
        let c = byteAt(s, afterSpace)
        if !(isAlphaByte(c) || c == '_' || c == ':') {
            i = afterSpace
            break
        }
        var j = afterSpace + 1
        while j < s.len {
            let a = s[j]
            if isAlnumByte(a) || a == '_' || a == '.' || a == ':' || a == '-' {
                j = j + 1
            } else {
                break
            }
        }
        // optional value
        let beforeEq = skipHtmlSpace(s, j)
        if byteAt(s, beforeEq) == '=' {
            var v = skipHtmlSpace(s, beforeEq + 1)
            let q = byteAt(s, v)
            if q == '"' || q == '\'' {
                v = v + 1
                while v < s.len && s[v] != q {
                    v = v + 1
                }
                if v >= s.len {
                    return -1
                }
                j = v + 1
            } else {
                let vstart = v
                while v < s.len {
                    let a = s[v]
                    if isHtmlSpace(a) || a == '"' || a == '\'' || a == '=' || a == '<' || a == '>' || a == '`' {
                        break
                    }
                    v = v + 1
                }
                if v == vstart {
                    return -1
                }
                j = v
            }
        }
        i = j
    }
    i = skipHtmlSpace(s, i)
    if byteAt(s, i) == '/' {
        i = i + 1
    }
    if byteAt(s, i) != '>' {
        return -1
    }
    return i + 1
}

// Index just past `</name>` at `start`, or -1.
fn scanCloseTag(s: &string, start: i64): i64 {
    if byteAt(s, start) != '<' || byteAt(s, start + 1) != '/' {
        return -1
    }
    let nameLen = scanTagName(s, start + 2)
    if nameLen == 0 {
        return -1
    }
    let i = skipHtmlSpace(s, start + 2 + nameLen)
    if byteAt(s, i) != '>' {
        return -1
    }
    return i + 1
}

// Index just past any inline raw-HTML construct at `start`, or -1: open tag,
// closing tag, comment, processing instruction, declaration, or CDATA.
fn scanHtmlInline(s: &string, start: i64): i64 {
    if byteAt(s, start) != '<' {
        return -1
    }
    let c = byteAt(s, start + 1)
    if c == '!' {
        let c2 = byteAt(s, start + 2)
        if c2 == '-' && byteAt(s, start + 3) == '-' {
            // Since 0.31 a comment is `<!-->`, `<!--->`, or `<!--` up to the
            // first `-->`; the old "no double hyphen inside" rule is gone.
            var i = start + 4
            if byteAt(s, i) == '>' {
                return i + 1
            }
            if byteAt(s, i) == '-' && byteAt(s, i + 1) == '>' {
                return i + 2
            }
            while i < s.len {
                if s[i] == '-' && byteAt(s, i + 1) == '-' && byteAt(s, i + 2) == '>' {
                    return i + 3
                }
                i = i + 1
            }
            return -1
        }
        if c2 == '[' && s[start + 2..s.len].startsWith("[CDATA[") {
            var i = start + 9
            while i < s.len {
                if s[i] == ']' && byteAt(s, i + 1) == ']' && byteAt(s, i + 2) == '>' {
                    return i + 3
                }
                i = i + 1
            }
            return -1
        }
        if isAlphaByte(c2) {
            var i = start + 2
            while i < s.len && s[i] != '>' {
                i = i + 1
            }
            if i >= s.len {
                return -1
            }
            return i + 1
        }
        return -1
    }
    if c == '?' {
        var i = start + 2
        while i < s.len {
            if s[i] == '?' && byteAt(s, i + 1) == '>' {
                return i + 2
            }
            i = i + 1
        }
        return -1
    }
    if c == '/' {
        return scanCloseTag(s, start)
    }
    return scanOpenTag(s, start)
}

// ── Block-start scanners ─────────────────────────────────────────────────────

// `***`, `---`, `___`: three or more of one character, spaces and tabs allowed
// between. Returns true if the rest of the line from `at` is a thematic break.
fn isThematicBreak(s: &string, at: i64): bool {
    let c = byteAt(s, at)
    if c != '*' && c != '-' && c != '_' {
        return false
    }
    var count: i64 = 0
    var i = at
    while i < s.len {
        let b = s[i]
        if b == c {
            count = count + 1
        } else if !isSpaceOrTab(b) {
            return false
        }
        i = i + 1
    }
    return count >= 3
}

// Number of `#`s of an ATX heading marker at `at`, or 0. The marker must be
// followed by a space, a tab, or the end of the line.
fn scanAtxMarker(s: &string, at: i64): i64 {
    var n: i64 = 0
    var i = at
    while i < s.len && s[i] == '#' && n < 7 {
        n = n + 1
        i = i + 1
    }
    if n == 0 || n > 6 {
        return 0
    }
    let c = byteAt(s, i)
    if c != 0 && !isSpaceOrTab(c) {
        return 0
    }
    return n
}

// Length of a code fence (3+ backticks or tildes) at `at`, or 0.
fn scanCodeFence(s: &string, at: i64): i64 {
    let c = byteAt(s, at)
    if c != '`' && c != '~' {
        return 0
    }
    var n: i64 = 0
    var i = at
    while i < s.len && s[i] == c {
        n = n + 1
        i = i + 1
    }
    if n < 3 {
        return 0
    }
    // An info string on a backtick fence may not itself contain a backtick,
    // otherwise `` `foo` `` inline code would be readable as a fence.
    if c == '`' {
        var j = i
        while j < s.len {
            if s[j] == '`' {
                return 0
            }
            j = j + 1
        }
    }
    return n
}

// Whether the line from `at` closes a fence of `fenceChar` x `fenceLen`.
fn isClosingFence(s: &string, at: i64, fenceChar: u8, fenceLen: i64): bool {
    var n: i64 = 0
    var i = at
    while i < s.len && s[i] == fenceChar {
        n = n + 1
        i = i + 1
    }
    if n < fenceLen {
        return false
    }
    while i < s.len {
        if !isSpaceOrTab(s[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

// 1 for `===`, 2 for `---`, 0 for anything else — a setext heading underline.
fn scanSetextLine(s: &string, at: i64): i64 {
    let c = byteAt(s, at)
    if c != '=' && c != '-' {
        return 0
    }
    var i = at
    while i < s.len && s[i] == c {
        i = i + 1
    }
    while i < s.len {
        if !isSpaceOrTab(s[i]) {
            return 0
        }
        i = i + 1
    }
    if c == '=' {
        return 1
    }
    return 2
}

// ── Parser state ─────────────────────────────────────────────────────────────

fn isKind(a: NodeKind, b: NodeKind): bool {
    return (a as i32) == (b as i32)
}

// Which containers may hold which children. A list holds only items; an item,
// a block quote and the document hold anything but a bare item; leaves hold
// nothing.
fn canContain(parent: NodeKind, child: NodeKind): bool {
    if isKind(parent, NodeKind.List) {
        return isKind(child, NodeKind.Item)
    }
    if isKind(parent, NodeKind.Document) || isKind(parent, NodeKind.BlockQuote) || isKind(parent, NodeKind.Item) {
        return !isKind(child, NodeKind.Item)
    }
    return false
}

// Leaves that swallow the rest of the line as text rather than letting new
// blocks start inside them.
fn acceptsLines(k: NodeKind): bool {
    return isKind(k, NodeKind.Paragraph) || isKind(k, NodeKind.CodeBlock)
    || isKind(k, NodeKind.HtmlBlock) || isKind(k, NodeKind.Table)
}

struct Delim {
    cc: u8,
    numdelims: i64,
    origdelims: i64,
    node: i64,
    prev: i64,
    next: i64,
    canOpen: bool,
    canClose: bool,
}

struct Bracket {
    node: i64,
    prev: i64,
    prevDelim: i64,
    index: i64,
    image: bool,
    active: bool,
    bracketAfter: bool,
}

struct MdParser {
    nodes: Vec<MdNode>,
    doc: i64,
    tip: i64,
    oldtip: i64,
    lastMatched: i64,

    line: string,
    pos: i64, // byte offset into `line`
    col: i64, // column, with tabs expanded to 4-column stops
    nextNonspace: i64,
    nextNonspaceCol: i64,
    indent: i64,
    indented: bool,
    blank: bool,
    partialTab: bool,
    allClosed: bool,
    lineNumber: i64,

    // Link reference definitions: normalized label -> index into refDest/refTitle.
    refKeys: HashMap<string, i64>,
    refDest: Vec<string>,
    refTitle: Vec<string>,

    // Inline phase.
    subject: string,
    ipos: i64,
    delims: Vec<Delim>,
    delimTop: i64,
    brackets: Vec<Bracket>,
    bracketTop: i64,
}

impl MdParser {
    fn new(): MdParser {
        var nodes: Vec<MdNode> = Vec.new()
        nodes.push(mdNode(NodeKind.Document))
        return MdParser {
            nodes: nodes,
            doc: 0,
            tip: 0,
            oldtip: 0,
            lastMatched: 0,
            line: "",
            pos: 0,
            col: 0,
            nextNonspace: 0,
            nextNonspaceCol: 0,
            indent: 0,
            indented: false,
            blank: false,
            partialTab: false,
            allClosed: true,
            lineNumber: 0,
            refKeys: HashMap.new(),
            refDest: Vec.new(),
            refTitle: Vec.new(),
            subject: "",
            ipos: 0,
            delims: Vec.new(),
            delimTop: -1,
            brackets: Vec.new(),
            bracketTop: -1,
        }
    }

    // ── Pool and tree plumbing ───────────────────────────────────────────────

    fn addNode(self: &mut Self, kind: NodeKind): i64 {
        let id = self.nodes.len
        self.nodes.push(mdNode(kind))
        return id
    }

    fn appendChild(self: &mut Self, parent: i64, child: i64): void {
        self.nodes[child].parent = parent
        self.nodes[child].next = -1
        let last = self.nodes[parent].lastChild
        self.nodes[child].prev = last
        if last >= 0 {
            self.nodes[last].next = child
        } else {
            self.nodes[parent].firstChild = child
        }
        self.nodes[parent].lastChild = child
    }

    fn unlinkNode(self: &mut Self, node: i64): void {
        let p = self.nodes[node].parent
        let nx = self.nodes[node].next
        let pv = self.nodes[node].prev
        if pv >= 0 {
            self.nodes[pv].next = nx
        } else if p >= 0 {
            self.nodes[p].firstChild = nx
        }
        if nx >= 0 {
            self.nodes[nx].prev = pv
        } else if p >= 0 {
            self.nodes[p].lastChild = pv
        }
        self.nodes[node].parent = -1
        self.nodes[node].next = -1
        self.nodes[node].prev = -1
    }

    // Splice `sibling` in directly after `node`.
    fn insertAfter(self: &mut Self, node: i64, sibling: i64): void {
        let nx = self.nodes[node].next
        self.nodes[sibling].next = nx
        if nx >= 0 {
            self.nodes[nx].prev = sibling
        }
        self.nodes[sibling].prev = node
        self.nodes[node].next = sibling
        let p = self.nodes[node].parent
        self.nodes[sibling].parent = p
        if nx < 0 && p >= 0 {
            self.nodes[p].lastChild = sibling
        }
    }

    fn addChild(self: &mut Self, kind: NodeKind): i64 {
        while !canContain(self.nodes[self.tip].kind, kind) {
            self.finalize(self.tip)
        }
        let n = self.addNode(kind)
        let t = self.tip
        self.appendChild(t, n)
        self.tip = n
        return n
    }

    // ── Line cursor, with the spec's tab-stop rules ──────────────────────────
    //
    // A tab advances to the next 4-column stop, so consuming *columns* can land
    // mid-tab. `partialTab` records that: the offset stays on the tab and
    // `addLine` re-emits the leftover columns as spaces. Expanding tabs up front
    // instead would be simpler and wrong — a tab inside a code block has to
    // survive into the output byte for byte.

    fn advanceOffset(self: &mut Self, amount: i64, columns: bool): void {
        var count = amount
        while count > 0 {
            let c = byteAt(self.line, self.pos)
            if c == 0 {
                break
            }
            if c == '\t' {
                let charsToTab = 4 - (self.col % 4)
                if columns {
                    self.partialTab = charsToTab > count
                    var charsToAdvance = charsToTab
                    if charsToTab > count {
                        charsToAdvance = count
                    }
                    self.col = self.col + charsToAdvance
                    if !self.partialTab {
                        self.pos = self.pos + 1
                    }
                    count = count - charsToAdvance
                } else {
                    self.partialTab = false
                    self.col = self.col + charsToTab
                    self.pos = self.pos + 1
                    count = count - 1
                }
            } else {
                self.partialTab = false
                self.pos = self.pos + 1
                self.col = self.col + 1
                count = count - 1
            }
        }
    }

    fn advanceNextNonspace(self: &mut Self): void {
        self.pos = self.nextNonspace
        self.col = self.nextNonspaceCol
        self.partialTab = false
    }

    fn findNextNonspace(self: &mut Self): void {
        var i = self.pos
        var cols = self.col
        while i < self.line.len {
            let c = self.line[i]
            if c == ' ' {
                i = i + 1
                cols = cols + 1
            } else if c == '\t' {
                i = i + 1
                cols = cols + (4 - (cols % 4))
            } else {
                break
            }
        }
        self.blank = i >= self.line.len
        self.nextNonspace = i
        self.nextNonspaceCol = cols
        self.indent = self.nextNonspaceCol - self.col
        self.indented = self.indent >= 4
    }

    fn addLine(self: &mut Self): void {
        let t = self.tip
        if self.partialTab {
            self.pos = self.pos + 1
            let charsToTab = 4 - (self.col % 4)
            let pad = " ".repeat(charsToTab)
            self.nodes[t].content.pushStr(pad)
        }
        let rest = self.line.substr(self.pos, self.line.len)
        self.nodes[t].content.pushStr(rest)
        self.nodes[t].content.push('\n')
    }

    fn closeUnmatchedBlocks(self: &mut Self): void {
        if self.allClosed {
            return
        }
        while self.oldtip != self.lastMatched {
            let parent = self.nodes[self.oldtip].parent
            self.finalize(self.oldtip)
            self.oldtip = parent
        }
        self.allClosed = true
    }

    // ── The line loop ────────────────────────────────────────────────────────
    //
    // For each line: walk the open containers checking whether the line
    // continues each one, then try to start new blocks, then hand what is left
    // to the deepest open leaf. This is the CommonMark reference algorithm; the
    // three phases are what make lazy continuation and list nesting fall out
    // instead of needing special cases.

    fn incorporateLine(self: &mut Self, ln: string): void {
        var allMatched = true
        var container = self.doc
        self.oldtip = self.tip
        self.pos = 0
        self.col = 0
        self.blank = false
        self.partialTab = false
        self.lineNumber = self.lineNumber + 1
        self.line = ln

        var lastChild = self.nodes[container].lastChild
        while lastChild >= 0 && self.nodes[lastChild].open {
            container = lastChild
            self.findNextNonspace()
            let r = self.continueBlock(container)
            if r == 1 {
                allMatched = false
            } else if r == 2 {
                return
            }
            if !allMatched {
                container = self.nodes[container].parent
                break
            }
            lastChild = self.nodes[container].lastChild
        }

        self.allClosed = container == self.oldtip
        self.lastMatched = container

        var matchedLeaf = !isKind(self.nodes[container].kind, NodeKind.Paragraph)
        && acceptsLines(self.nodes[container].kind)
        while !matchedLeaf {
            self.findNextNonspace()
            // Nothing that can begin a block starts with this byte, so skip the
            // eight start scanners entirely — this is the hot path for ordinary
            // paragraph text.
            if !self.indented && !maybeSpecial(byteAt(self.line, self.nextNonspace)) {
                self.advanceNextNonspace()
                break
            }
            let res = self.tryBlockStarts(container)
            if res == 0 {
                self.advanceNextNonspace()
                break
            }
            container = self.tip
            if res == 2 {
                matchedLeaf = true
            }
        }

        // What is left of the line is text for the deepest open block.
        if !self.allClosed && !self.blank && isKind(self.nodes[self.tip].kind, NodeKind.Paragraph) {
            // Lazy continuation: a paragraph inside a container keeps going even
            // though the container's own marker is missing on this line.
            self.addLine()
            return
        }

        self.closeUnmatchedBlocks()
        // A blank line ends the block that was open on it, and that block is
        // what list tightness is measured on — without this the paragraph
        // before the blank never records it and every list reads as tight.
        if self.blank && self.nodes[container].lastChild >= 0 {
            let lc = self.nodes[container].lastChild
            self.nodes[lc].lastLineBlank = true
        }
        let k = self.nodes[container].kind

        // A blank line inside a block quote or a fenced code block does not
        // count for list tightness, and neither does one on an item's own
        // marker line.
        var lastLineBlank = self.blank
        if isKind(k, NodeKind.BlockQuote) {
            lastLineBlank = false
        } else if isKind(k, NodeKind.CodeBlock) && self.nodes[container].isFenced {
            lastLineBlank = false
        } else if isKind(k, NodeKind.Item) && self.nodes[container].firstChild < 0 {
            lastLineBlank = false
        }
        var cont = container
        while cont >= 0 {
            self.nodes[cont].lastLineBlank = lastLineBlank
            cont = self.nodes[cont].parent
        }

        if acceptsLines(k) {
            self.addLine()
            if isKind(k, NodeKind.HtmlBlock) {
                let t = self.nodes[container].htmlBlockType
                if t >= 1 && t <= 5 && self.htmlBlockCloses(t) {
                    self.finalize(container)
                }
            }
        } else if self.pos < self.line.len && !self.blank {
            let p = self.addChild(NodeKind.Paragraph)
            self.advanceNextNonspace()
            self.addLine()
        }
    }

    // 0 = matched, 1 = did not match, 2 = line consumed entirely.
    fn continueBlock(self: &mut Self, container: i64): i64 {
        let k = self.nodes[container].kind
        if isKind(k, NodeKind.Document) || isKind(k, NodeKind.List) {
            return 0
        }
        if isKind(k, NodeKind.BlockQuote) {
            if !self.indented && byteAt(self.line, self.nextNonspace) == '>' {
                self.advanceNextNonspace()
                self.advanceOffset(1, false)
                if isSpaceOrTab(byteAt(self.line, self.pos)) {
                    self.advanceOffset(1, true)
                }
                return 0
            }
            return 1
        }
        if isKind(k, NodeKind.Item) {
            if self.blank {
                if self.nodes[container].firstChild < 0 {
                    return 1
                }
                self.advanceNextNonspace()
                return 0
            }
            let need = self.nodes[container].listMarkerOffset + self.nodes[container].listPadding
            if self.indent >= need {
                self.advanceOffset(need, true)
                return 0
            }
            return 1
        }
        if isKind(k, NodeKind.Heading) || isKind(k, NodeKind.ThematicBreak) {
            return 1
        }
        if isKind(k, NodeKind.CodeBlock) {
            if self.nodes[container].isFenced {
                let fc = self.nodes[container].fenceChar
                let fl = self.nodes[container].fenceLen
                if !self.indented && isClosingFence(self.line, self.nextNonspace, fc, fl) {
                    self.finalize(container)
                    return 2
                }
                // A closing fence may be indented up to the opening fence's own
                // indent, and that much indentation is stripped from content.
                var n = self.nodes[container].fenceOffset
                while n > 0 && isSpaceOrTab(byteAt(self.line, self.pos)) {
                    self.advanceOffset(1, true)
                    n = n - 1
                }
                return 0
            }
            if self.indent >= 4 {
                self.advanceOffset(4, true)
                return 0
            }
            if self.blank {
                self.advanceNextNonspace()
                return 0
            }
            return 1
        }
        if isKind(k, NodeKind.HtmlBlock) {
            let t = self.nodes[container].htmlBlockType
            if self.blank && (t == 6 || t == 7) {
                return 1
            }
            return 0
        }
        if isKind(k, NodeKind.Paragraph) {
            if self.blank {
                return 1
            }
            return 0
        }
        if isKind(k, NodeKind.Table) {
            if self.blank {
                return 1
            }
            // GFM ends a table at the first blank line or the start of another
            // block-level structure. Since a table swallows lines, the check has
            // to happen here rather than in the block-start scanners.
            if self.tableLineEnds() {
                return 1
            }
            return 0
        }
        return 0
    }

    // 0 = no start, 1 = new container, 2 = new leaf (stop trying starts).
    fn tryBlockStarts(self: &mut Self, container: i64): i64 {
        // block quote
        if !self.indented && byteAt(self.line, self.nextNonspace) == '>' {
            self.advanceNextNonspace()
            self.advanceOffset(1, false)
            if isSpaceOrTab(byteAt(self.line, self.pos)) {
                self.advanceOffset(1, true)
            }
            self.closeUnmatchedBlocks()
            self.addChild(NodeKind.BlockQuote)
            return 1
        }

        // ATX heading
        let hashes = scanAtxMarker(self.line, self.nextNonspace)
        if !self.indented && hashes > 0 {
            self.advanceNextNonspace()
            self.advanceOffset(hashes, false)
            while isSpaceOrTab(byteAt(self.line, self.pos)) {
                self.advanceOffset(1, false)
            }
            self.closeUnmatchedBlocks()
            let h = self.addChild(NodeKind.Heading)
            self.nodes[h].level = hashes
            let raw = self.line.substr(self.pos, self.line.len)
            let stripped = stripAtxTrailing(raw)
            self.nodes[h].content = stripped
            let remaining = self.line.len - self.pos
            self.advanceOffset(remaining, false)
            return 2
        }

        // fenced code block
        let fenceLen = scanCodeFence(self.line, self.nextNonspace)
        if !self.indented && fenceLen > 0 {
            let fc = byteAt(self.line, self.nextNonspace)
            let fo = self.indent
            self.closeUnmatchedBlocks()
            let c = self.addChild(NodeKind.CodeBlock)
            self.nodes[c].isFenced = true
            self.nodes[c].fenceLen = fenceLen
            self.nodes[c].fenceChar = fc
            self.nodes[c].fenceOffset = fo
            self.advanceNextNonspace()
            self.advanceOffset(fenceLen, false)
            return 2
        }

        // html block
        if !self.indented && byteAt(self.line, self.nextNonspace) == '<' {
            let bt = self.htmlBlockStartType(container)
            if bt > 0 {
                self.closeUnmatchedBlocks()
                let b = self.addChild(NodeKind.HtmlBlock)
                self.nodes[b].htmlBlockType = bt
                return 2
            }
        }

        // GFM table: a one-line paragraph followed by a delimiter row.
        if !self.indented && isKind(self.nodes[container].kind, NodeKind.Paragraph) {
            if self.tryTableStart(container) {
                return 2
            }
        }

        // setext heading underline
        if !self.indented && isKind(self.nodes[container].kind, NodeKind.Paragraph) {
            let lvl = scanSetextLine(self.line, self.nextNonspace)
            if lvl > 0 {
                self.closeUnmatchedBlocks()
                self.consumeRefDefs(container)
                if self.nodes[container].content.len > 0 {
                    let h = self.addNode(NodeKind.Heading)
                    self.nodes[h].level = lvl
                    let text = self.nodes[container].content.clone()
                    self.nodes[h].content = text
                    self.insertAfter(container, h)
                    self.unlinkNode(container)
                    self.tip = h
                    let remaining = self.line.len - self.pos
                    self.advanceOffset(remaining, false)
                    return 2
                }
                return 0
            }
        }

        // thematic break
        if !self.indented && isThematicBreak(self.line, self.nextNonspace) {
            self.closeUnmatchedBlocks()
            self.addChild(NodeKind.ThematicBreak)
            let remaining = self.line.len - self.pos
            self.advanceOffset(remaining, false)
            return 2
        }

        // list item
        if !self.indented || isKind(self.nodes[container].kind, NodeKind.List) {
            let data = self.parseListMarker(container)
            if data.ok {
                self.closeUnmatchedBlocks()
                if !isKind(self.nodes[self.tip].kind, NodeKind.List) || !self.listMatches(container, data) {
                    let l = self.addChild(NodeKind.List)
                    self.nodes[l].listOrdered = data.ordered
                    self.nodes[l].listDelim = data.delim
                    self.nodes[l].level = data.start
                    self.nodes[l].listTight = true
                }
                let it = self.addChild(NodeKind.Item)
                self.nodes[it].listOrdered = data.ordered
                self.nodes[it].listDelim = data.delim
                self.nodes[it].listPadding = data.padding
                self.nodes[it].listMarkerOffset = data.markerOffset
                return 1
            }
        }

        // indented code block
        if self.indented && !isKind(self.nodes[self.tip].kind, NodeKind.Paragraph) && !self.blank {
            self.advanceOffset(4, true)
            self.closeUnmatchedBlocks()
            self.addChild(NodeKind.CodeBlock)
            return 2
        }

        return 0
    }

    // Does the list `container` (or the innermost open list) accept an item with
    // this marker? A different bullet or delimiter starts a new list.
    fn listMatches(self: &Self, container: i64, data: ListData): bool {
        if !isKind(self.nodes[container].kind, NodeKind.List) {
            return false
        }
        return self.nodes[container].listOrdered == data.ordered
        && self.nodes[container].listDelim == data.delim
    }

    fn parseListMarker(self: &mut Self, container: i64): ListData {
        var data = ListData {
            ordered: false, bulletChar: 0, start: 1, delim: 0,
            padding: 0, markerOffset: self.indent, ok: false,
        }
        if self.indent >= 4 {
            return data
        }
        let at = self.nextNonspace
        let c = byteAt(self.line, at)
        var markerLen: i64 = 0
        if c == '-' || c == '+' || c == '*' {
            data.ordered = false
            data.delim = c
            markerLen = 1
        } else if isDigitByte(c) {
            var i = at
            var digits: i64 = 0
            var value: i64 = 0
            while i < self.line.len && isDigitByte(self.line[i]) && digits < 10 {
                value = value * 10 + ((self.line[i] - '0') as i64)
                digits = digits + 1
                i = i + 1
            }
            if digits > 9 {
                return data
            }
            let d = byteAt(self.line, i)
            if d != '.' && d != ')' {
                return data
            }
            // An ordered list may only interrupt a paragraph if it starts at 1.
            if isKind(self.nodes[container].kind, NodeKind.Paragraph) && value != 1 {
                return data
            }
            data.ordered = true
            data.start = value
            data.delim = d
            markerLen = digits + 1
        } else {
            return data
        }

        let after = byteAt(self.line, at + markerLen)
        if after != 0 && !isSpaceOrTab(after) {
            return data
        }
        // A list may not interrupt a paragraph with an empty first item.
        if isKind(self.nodes[container].kind, NodeKind.Paragraph) {
            var j = at + markerLen
            var sawContent = false
            while j < self.line.len {
                if !isSpaceOrTab(self.line[j]) {
                    sawContent = true
                    break
                }
                j = j + 1
            }
            if !sawContent {
                return data
            }
        }

        self.advanceNextNonspace()
        self.advanceOffset(markerLen, true)
        let spacesStartCol = self.col
        let spacesStartPos = self.pos
        var scanning = true
        while scanning {
            self.advanceOffset(1, true)
            let n = byteAt(self.line, self.pos)
            scanning = self.col - spacesStartCol < 5 && isSpaceOrTab(n)
        }
        let blankItem = byteAt(self.line, self.pos) == 0
        let spacesAfter = self.col - spacesStartCol
        if spacesAfter >= 5 || spacesAfter < 1 || blankItem {
            // Content starts more than one space away (or nowhere): the item's
            // content column is the marker plus a single space, and the extra
            // spaces belong to whatever the content turns out to be.
            data.padding = markerLen + 1
            self.col = spacesStartCol
            self.pos = spacesStartPos
            if isSpaceOrTab(byteAt(self.line, self.pos)) {
                self.advanceOffset(1, true)
            }
        } else {
            data.padding = markerLen + spacesAfter
        }
        data.ok = true
        return data
    }

    // ── HTML block conditions ────────────────────────────────────────────────

    // Which of the spec's seven html-block start conditions the current line
    // meets, or 0. Condition 7 (any complete tag alone on its line) is the one
    // that may not interrupt a paragraph.
    fn htmlBlockStartType(self: &Self, container: i64): i64 {
        let at = self.nextNonspace
        let c1 = byteAt(self.line, at + 1)
        // 2: comment, 3: processing instruction, 4: declaration, 5: CDATA
        if c1 == '!' {
            let c2 = byteAt(self.line, at + 2)
            if c2 == '-' && byteAt(self.line, at + 3) == '-' {
                return 2
            }
            if c2 == '[' && self.line[at + 2..self.line.len].startsWith("[CDATA[") {
                return 5
            }
            if isAlphaByte(c2) {
                return 4
            }
            return 0
        }
        if c1 == '?' {
            return 3
        }
        var nameAt = at + 1
        var closing = false
        if c1 == '/' {
            nameAt = at + 2
            closing = true
        }
        let nameLen = scanTagName(self.line, nameAt)
        if nameLen > 0 {
            let name = self.line.substr(nameAt, nameAt + nameLen)
            let after = byteAt(self.line, nameAt + nameLen)
            // 1: <script>, <pre>, <style>, <textarea> — raw text to the matching
            // close tag, blank lines included.
            if !closing && isRawTextTag(name) && (after == 0 || isHtmlSpace(after) || after == '>') {
                return 1
            }
            // 6: a known block-level tag.
            if isHtmlBlockTag(name) && (after == 0 || isHtmlSpace(after) || after == '>' || (after == '/' && byteAt(self.line, nameAt + nameLen + 1) == '>')) {
                return 6
            }
        }
        // 7: a complete open or closing tag, with nothing else on the line.
        let isPara = isKind(self.nodes[container].kind, NodeKind.Paragraph)
        let lazyPara = !self.allClosed && !self.blank && isKind(self.nodes[self.tip].kind, NodeKind.Paragraph)
        if isPara || lazyPara {
            return 0
        }
        var end = scanOpenTag(self.line, at)
        if end < 0 {
            end = scanCloseTag(self.line, at)
        }
        if end < 0 {
            return 0
        }
        var i = end
        while i < self.line.len {
            if !isSpaceOrTab(self.line[i]) {
                return 0
            }
            i = i + 1
        }
        return 7
    }

    fn htmlBlockCloses(self: &Self, blockType: i64): bool {
        let rest = self.line.substr(self.pos, self.line.len)
        if blockType == 1 {
            let lower = toLowerStr(rest)
            return lower.contains("</script>") || lower.contains("</pre>")
            || lower.contains("</style>") || lower.contains("</textarea>")
        }
        if blockType == 2 {
            return rest.contains("-->")
        }
        if blockType == 3 {
            return rest.contains("?>")
        }
        if blockType == 4 {
            return rest.contains(">")
        }
        if blockType == 5 {
            return rest.contains("]]>")
        }
        return false
    }

    // ── Finalizing ───────────────────────────────────────────────────────────

    fn finalize(self: &mut Self, block: i64): void {
        let above = self.nodes[block].parent
        self.nodes[block].open = false
        let k = self.nodes[block].kind

        if isKind(k, NodeKind.CodeBlock) {
            if self.nodes[block].isFenced {
                let content = self.nodes[block].content.clone()
                var firstLine = content.clone()
                var rest = ""
                match content.indexOf("\n") {
                    Option.Some(nl) => {
                        firstLine = content.substr(0, nl)
                        rest = content.substr(nl + 1, content.len)
                    }
                    Option.None => {
                    }
                }
                let info = unescapeString(firstLine.trim())
                self.nodes[block].dest = info
                self.nodes[block].literal = rest
            } else {
                let content = self.nodes[block].content.clone()
                let body = stripTrailingBlankLines(content, true)
                self.nodes[block].literal = body
            }
            self.nodes[block].content = ""
        } else if isKind(k, NodeKind.HtmlBlock) {
            // A raw block's lines are its content verbatim, trailing blank
            // line included: `cr` before and after it is what keeps the tags on
            // their own lines, so stripping here would eat a real newline.
            let content = self.nodes[block].content.clone()
            self.nodes[block].literal = content
            self.nodes[block].content = ""
        } else if isKind(k, NodeKind.List) {
            self.finalizeList(block)
        } else if isKind(k, NodeKind.Table) {
            self.finalizeTable(block)
        }

        self.tip = above
    }

    // A list is loose if any item, or any of an item's children, ends with a
    // blank line that is not at the very end of the list.
    // Whether a block's last line was blank, looking through a trailing list or
    // item: a blank line inside a nested list is recorded on the paragraph that
    // it closed, not on the list, and the outer list's looseness depends on it.
    fn endsWithBlankLine(self: &Self, node: i64): bool {
        var b = node
        while b >= 0 {
            if self.nodes[b].lastLineBlank {
                return true
            }
            let k = self.nodes[b].kind
            if isKind(k, NodeKind.List) || isKind(k, NodeKind.Item) {
                b = self.nodes[b].lastChild
            } else {
                return false
            }
        }
        return false
    }

    fn finalizeList(self: &mut Self, block: i64): void {
        var item = self.nodes[block].firstChild
        while item >= 0 {
            if self.endsWithBlankLine(item) && self.nodes[item].next >= 0 {
                self.nodes[block].listTight = false
                return
            }
            var sub = self.nodes[item].firstChild
            var broke = false
            while sub >= 0 && !broke {
                if self.endsWithBlankLine(sub) && (self.nodes[item].next >= 0 || self.nodes[sub].next >= 0) {
                    self.nodes[block].listTight = false
                    broke = true
                } else {
                    sub = self.nodes[sub].next
                }
            }
            if broke {
                return
            }
            item = self.nodes[item].next
        }
    }

    // Strip link reference definitions off the front of a block's content,
    // recording them. Returns whether any were found.
    fn consumeRefDefs(self: &mut Self, block: i64): bool {
        var found = false
        var content = self.nodes[block].content.clone()
        while byteAt(content, 0) == '[' {
            let used = self.parseReference(content)
            if used <= 0 {
                break
            }
            content = content.substr(used, content.len)
            found = true
        }
        if found {
            self.nodes[block].content = content
        }
        return found
    }

    // Link reference definitions come off the front of every paragraph in a
    // separate pass, after the whole block tree exists. Doing it in the
    // paragraph's finalizer instead would run it while the list containing the
    // paragraph is still deciding whether it is tight, and a definition that
    // empties its paragraph would make the blank line before it disappear.
    fn collectRefDefs(self: &mut Self, node: i64): void {
        var c = self.nodes[node].firstChild
        while c >= 0 {
            let nx = self.nodes[c].next
            if isKind(self.nodes[c].kind, NodeKind.Paragraph) {
                let hadRefs = self.consumeRefDefs(c)
                if hadRefs && isBlankStr(self.nodes[c].content) {
                    self.unlinkNode(c)
                }
            } else {
                self.collectRefDefs(c)
            }
            c = nx
        }
    }

    fn processInlines(self: &mut Self, node: i64): void {
        let k = self.nodes[node].kind
        if isKind(k, NodeKind.Paragraph) || isKind(k, NodeKind.Heading) || isKind(k, NodeKind.TableCell) {
            self.parseInlines(node)
        }
        var c = self.nodes[node].firstChild
        while c >= 0 {
            let nx = self.nodes[c].next
            self.processInlines(c)
            c = nx
        }
    }

    fn parseAll(self: &mut Self, src: string): void {
        let lines = mdSplitLines(src)
        for i in 0..lines.len {
            let ln = lines[i].clone()
            self.incorporateLine(ln)
        }
        while self.tip >= 0 {
            self.finalize(self.tip)
        }
        let root = self.doc
        self.markTaskItems(root)
        self.collectRefDefs(root)
        self.processInlines(root)
    }
}

// Marker data for one list item, filled in by parseListMarker.
struct ListData {
    ordered: bool,
    bulletChar: u8,
    start: i64,
    delim: u8,
    padding: i64,
    markerOffset: i64,
    ok: bool,
}

// Bytes that can begin a block-level construct. Anything else on a line means
// the eight start scanners cannot match, so they are skipped wholesale.
fn maybeSpecial(c: u8): bool {
    return c == '#' || c == '`' || c == '~' || c == '*' || c == '+' || c == '_'
    || c == '=' || c == '<' || c == '>' || c == '-' || c == '|' || isDigitByte(c)
}

// Split into lines on \n, \r\n or \r, dropping the empty piece a trailing
// newline would produce. NUL becomes U+FFFD here, which is the one place the
// spec asks for a substitution and the reason `byteAt` can use 0 for "end".
fn mdSplitLines(src: &string): Vec<string> {
    var out: Vec<string> = Vec.new()
    var cur = ""
    var i: i64 = 0
    while i < src.len {
        let c = src[i]
        if c == '\n' {
            out.push(cur.clone())
            cur = ""
            i = i + 1
        } else if c == '\r' {
            out.push(cur.clone())
            cur = ""
            if byteAt(src, i + 1) == '\n' {
                i = i + 2
            } else {
                i = i + 1
            }
        } else if c == 0 {
            encodeCodepoint(cur, 65533)
            i = i + 1
        } else {
            cur.push(c)
            i = i + 1
        }
    }
    if cur.len > 0 {
        out.push(cur.clone())
    }
    return out
}

// Drop the trailing run of blank lines. `keepNewline` leaves one final newline,
// which is what a code block's content needs and an html block's does not.
fn stripTrailingBlankLines(s: &string, keepNewline: bool): string {
    var end = s.len
    var going = true
    while going {
        var e = end
        while e > 0 && (s[e - 1] == ' ' || s[e - 1] == '\t') {
            e = e - 1
        }
        if e > 0 && s[e - 1] == '\n' {
            end = e - 1
        } else {
            going = false
        }
    }
    var out = s.substr(0, end)
    if keepNewline && out.len > 0 {
        out.push('\n')
    }
    return out
}

// Remove an ATX heading's optional closing run of #s: `## foo ##` is `foo`, but
// `## foo#` is `foo#` — the run has to be preceded by a space.
fn stripAtxTrailing(s: &string): string {
    var end = s.len
    while end > 0 && isSpaceOrTab(s[end - 1]) {
        end = end - 1
    }
    var h = end
    while h > 0 && s[h - 1] == '#' {
        h = h - 1
    }
    if h < end {
        if h == 0 {
            return ""
        }
        if isSpaceOrTab(s[h - 1]) {
            var e2 = h
            while e2 > 0 && isSpaceOrTab(s[e2 - 1]) {
                e2 = e2 - 1
            }
            return s.substr(0, e2)
        }
    }
    return s.substr(0, end)
}

// ── Inline phase ─────────────────────────────────────────────────────────────

struct DelimScan {
    numdelims: i64,
    canOpen: bool,
    canClose: bool,
}

// Codepoint immediately before byte `at`, or '\n' at the start of the subject —
// the spec treats the beginning of a line as whitespace for flanking purposes.
fn cpBefore(s: &string, at: i64): i32 {
    if at <= 0 {
        return 10
    }
    var i = at - 1
    while i > 0 && (s[i] & 192) == 128 {
        i = i - 1
    }
    let d = decodeCodepoint(s, i)
    return d.value
}

fn cpAfter(s: &string, at: i64): i32 {
    if at >= s.len {
        return 10
    }
    let d = decodeCodepoint(s, at)
    return d.value
}

// A code span's content: newlines fold to spaces, and one space is stripped from
// each end when both ends have one and the content is not all spaces.
fn collapseCodeSpan(raw: &string): string {
    var out = ""
    for c in raw {
        if c == '\n' {
            out.push(' ')
        } else {
            out.push(c)
        }
    }
    if out.len >= 2 && out[0] == ' ' && out[out.len - 1] == ' ' {
        var allSpace = true
        for c in out {
            if c != ' ' {
                allSpace = false
            }
        }
        if !allSpace {
            return out.substr(1, out.len - 1)
        }
    }
    return out
}

impl MdParser {
    fn addText(self: &mut Self, block: i64, s: string): i64 {
        let t = self.addNode(NodeKind.Text)
        self.nodes[t].literal = s
        self.appendChild(block, t)
        return t
    }

    fn parseInlines(self: &mut Self, block: i64): void {
        let content = self.nodes[block].content.clone()
        self.subject = content.trim()
        self.nodes[block].content = ""
        self.ipos = 0
        self.delims.clear()
        self.delimTop = -1
        self.brackets.clear()
        self.bracketTop = -1
        var going = true
        while going {
            going = self.parseInline(block)
        }
        self.processEmphasis(-1)
        self.gfmAutolinkPass(block)
    }

    fn parseInline(self: &mut Self, block: i64): bool {
        if self.ipos >= self.subject.len {
            return false
        }
        let c = self.subject[self.ipos]
        var res = false
        if c == '\n' {
            res = self.parseNewline(block)
        } else if c == '\\' {
            res = self.parseBackslash(block)
        } else if c == '`' {
            res = self.parseBackticks(block)
        } else if c == '*' || c == '_' || c == '~' {
            res = self.handleDelim(c, block)
        } else if c == '[' {
            res = self.parseOpenBracket(block)
        } else if c == '!' {
            res = self.parseBang(block)
        } else if c == ']' {
            res = self.parseCloseBracket(block)
        } else if c == '<' {
            res = self.parseAutolink(block)
            if !res {
                res = self.parseHtmlTag(block)
            }
        } else if c == '&' {
            res = self.parseEntity(block)
        } else {
            res = self.parseString(block)
        }
        if !res {
            self.ipos = self.ipos + 1
            var lit = ""
            lit.push(c)
            self.addText(block, lit)
        }
        return true
    }

    fn parseNewline(self: &mut Self, block: i64): bool {
        self.ipos = self.ipos + 1
        var hard = false
        let last = self.nodes[block].lastChild
        if last >= 0 && isKind(self.nodes[last].kind, NodeKind.Text) {
            let lit = self.nodes[last].literal.clone()
            if lit.len > 0 && lit[lit.len - 1] == ' ' {
                // Two or more trailing spaces before the newline is a hard break.
                hard = lit.len > 1 && lit[lit.len - 2] == ' '
                var e = lit.len
                while e > 0 && lit[e - 1] == ' ' {
                    e = e - 1
                }
                self.nodes[last].literal = lit.substr(0, e)
            }
        }
        var br = self.addNode(NodeKind.SoftBreak)
        if hard {
            self.nodes[br].kind = NodeKind.LineBreak
        }
        self.appendChild(block, br)
        // Leading whitespace on the next line is not content.
        while byteAt(self.subject, self.ipos) == ' ' || byteAt(self.subject, self.ipos) == '\t' {
            self.ipos = self.ipos + 1
        }
        return true
    }

    fn parseBackslash(self: &mut Self, block: i64): bool {
        self.ipos = self.ipos + 1
        let c = byteAt(self.subject, self.ipos)
        if c == '\n' {
            self.ipos = self.ipos + 1
            let br = self.addNode(NodeKind.LineBreak)
            self.appendChild(block, br)
            return true
        }
        if isAsciiPunct(c) {
            var lit = ""
            lit.push(c)
            self.addText(block, lit)
            self.ipos = self.ipos + 1
            return true
        }
        self.addText(block, "\\")
        return true
    }

    fn parseBackticks(self: &mut Self, block: i64): bool {
        let start = self.ipos
        var n: i64 = 0
        while byteAt(self.subject, self.ipos) == '`' {
            n = n + 1
            self.ipos = self.ipos + 1
        }
        let afterOpen = self.ipos
        var i = afterOpen
        while i < self.subject.len {
            if self.subject[i] == '`' {
                var m: i64 = 0
                var j = i
                while j < self.subject.len && self.subject[j] == '`' {
                    m = m + 1
                    j = j + 1
                }
                if m == n {
                    let raw = self.subject.substr(afterOpen, i)
                    let body = collapseCodeSpan(raw)
                    let c = self.addNode(NodeKind.Code)
                    self.nodes[c].literal = body
                    self.appendChild(block, c)
                    self.ipos = j
                    return true
                }
                i = j
            } else {
                i = i + 1
            }
        }
        // No closing run of the same length: the opener is literal text.
        self.ipos = afterOpen
        let lit = self.subject.substr(start, afterOpen)
        self.addText(block, lit)
        return true
    }

    fn parseEntity(self: &mut Self, block: i64): bool {
        let start = self.ipos
        let end = scanEntity(self.subject, start)
        if end < 0 {
            return false
        }
        let raw = self.subject.substr(start, end)
        let decoded = decodeEntityRef(raw)
        self.ipos = end
        self.addText(block, decoded)
        return true
    }

    fn parseHtmlTag(self: &mut Self, block: i64): bool {
        let end = scanHtmlInline(self.subject, self.ipos)
        if end < 0 {
            return false
        }
        let raw = self.subject.substr(self.ipos, end)
        let h = self.addNode(NodeKind.HtmlInline)
        self.nodes[h].literal = raw
        self.appendChild(block, h)
        self.ipos = end
        return true
    }

    fn parseAutolink(self: &mut Self, block: i64): bool {
        let close = scanAutolinkUri(self.subject, self.ipos)
        if close > 0 {
            let dest = self.subject.substr(self.ipos + 1, close)
            let node = self.addNode(NodeKind.Link)
            self.nodes[node].dest = dest.clone()
            self.appendChild(block, node)
            self.addText(node, dest.clone())
            self.ipos = close + 1
            return true
        }
        let mail = scanAutolinkEmail(self.subject, self.ipos)
        if mail > 0 {
            let addr = self.subject.substr(self.ipos + 1, mail)
            let node = self.addNode(NodeKind.Link)
            self.nodes[node].dest = "mailto:" + addr
            self.appendChild(block, node)
            self.addText(node, addr.clone())
            self.ipos = mail + 1
            return true
        }
        return false
    }

    fn parseString(self: &mut Self, block: i64): bool {
        let start = self.ipos
        var i = start
        while i < self.subject.len {
            let c = self.subject[i]
            if c == '\n' || c == '`' || c == '[' || c == ']' || c == '\\' || c == '!'
            || c == '<' || c == '&' || c == '*' || c == '_' || c == '~' {
                break
            }
            i = i + 1
        }
        if i == start {
            return false
        }
        let lit = self.subject.substr(start, i)
        self.ipos = i
        self.addText(block, lit)
        return true
    }

    // ── Emphasis ─────────────────────────────────────────────────────────────

    fn scanDelims(self: &mut Self, cc: u8): DelimScan {
        var numdelims: i64 = 0
        let startpos = self.ipos
        while byteAt(self.subject, self.ipos) == cc {
            numdelims = numdelims + 1
            self.ipos = self.ipos + 1
        }
        if numdelims == 0 {
            return DelimScan {
                numdelims: 0, canOpen: false, canClose: false
            }
        }
        let before = cpBefore(self.subject, startpos)
        let after = cpAfter(self.subject, self.ipos)
        let afterWs = isUnicodeWhitespaceCp(after)
        let afterPunct = isUnicodePunctCp(after)
        let beforeWs = isUnicodeWhitespaceCp(before)
        let beforePunct = isUnicodePunctCp(before)
        let leftFlanking = !afterWs && (!afterPunct || beforeWs || beforePunct)
        let rightFlanking = !beforeWs && (!beforePunct || afterWs || afterPunct)
        var canOpen = leftFlanking
        var canClose = rightFlanking
        // `_` may not open or close inside a word: intra-word emphasis is a
        // snake_case hazard, and the spec singles it out.
        if cc == '_' {
            canOpen = leftFlanking && (!rightFlanking || beforePunct)
            canClose = rightFlanking && (!leftFlanking || afterPunct)
        }
        self.ipos = startpos
        return DelimScan {
            numdelims: numdelims, canOpen: canOpen, canClose: canClose
        }
    }

    fn handleDelim(self: &mut Self, cc: u8, block: i64): bool {
        let scan = self.scanDelims(cc)
        if scan.numdelims == 0 {
            return false
        }
        // GFM strikethrough is at most a double tilde; a longer run is literal.
        if cc == '~' && scan.numdelims > 2 {
            let start = self.ipos
            self.ipos = self.ipos + scan.numdelims
            let lit = self.subject.substr(start, self.ipos)
            self.addText(block, lit)
            return true
        }
        let start = self.ipos
        self.ipos = self.ipos + scan.numdelims
        let lit = self.subject.substr(start, self.ipos)
        let node = self.addText(block, lit)
        let id = self.delims.len
        self.delims.push(Delim {
            cc: cc,
            numdelims: scan.numdelims,
            origdelims: scan.numdelims,
            node: node,
            prev: self.delimTop,
            next: -1,
            canOpen: scan.canOpen,
            canClose: scan.canClose,
        }
        )
        if self.delimTop >= 0 {
            self.delims[self.delimTop].next = id
        }
        self.delimTop = id
        return true
    }

    fn removeDelimiter(self: &mut Self, d: i64): void {
        let pv = self.delims[d].prev
        let nx = self.delims[d].next
        if pv >= 0 {
            self.delims[pv].next = nx
        }
        if nx < 0 {
            self.delimTop = pv
        } else {
            self.delims[nx].prev = pv
        }
    }

    fn removeDelimsBetween(self: &mut Self, bottom: i64, top: i64): void {
        if self.delims[top].prev != bottom {
            self.delims[top].prev = bottom
            self.delims[bottom].next = top
        }
    }

    // The spec's "process emphasis" algorithm: walk the delimiter stack looking
    // for closers, and for each, look back for the nearest matching opener.
    // `openersBottom` is what keeps a failed search from being quadratic, and
    // the `% 3` rule is the spec's fix for `***foo***`-style runs.
    fn processEmphasis(self: &mut Self, stackBottom: i64): void {
        // One bottom per (delimiter char, run length mod 3, can-also-open).
        // The last of those three is easy to miss and its absence is invisible
        // on the spec suite: it only shows up on runs like `****a**b***c****`,
        // where a closer that could also have opened must not lower the bar for
        // a later closer that could not.
        var openersBottom: Vec<i64> = Vec.new()
        for i in 0..20 {
            openersBottom.push(stackBottom)
        }

        var closer = self.delimTop
        while closer >= 0 && self.delims[closer].prev != stackBottom {
            closer = self.delims[closer].prev
        }

        while closer >= 0 {
            let cc = self.delims[closer].cc
            if !self.delims[closer].canClose {
                closer = self.delims[closer].next
                continue
            }
            var slot = self.delims[closer].origdelims % 3
            if self.delims[closer].canOpen {
                slot = slot + 3
            }
            if cc == '_' {
                slot = slot + 2
            } else if cc == '*' {
                slot = slot + 8
            } else {
                slot = slot + 14
            }
            var opener = self.delims[closer].prev
            var openerFound = false
            while opener >= 0 && opener != stackBottom && opener != openersBottom[slot] {
                let oddMatch = (self.delims[closer].canOpen || self.delims[opener].canClose)
                && (self.delims[closer].origdelims % 3 != 0)
                && ((self.delims[opener].origdelims + self.delims[closer].origdelims) % 3 == 0)
                if self.delims[opener].cc == cc && self.delims[opener].canOpen && !oddMatch {
                    openerFound = true
                    break
                }
                opener = self.delims[opener].prev
            }
            let oldCloser = closer

            if !openerFound {
                closer = self.delims[closer].next
            } else if cc == '~' {
                // GFM: the runs must be the same length, and `~~~` is not
                // strikethrough at all.
                if self.delims[opener].numdelims != self.delims[closer].numdelims {
                    closer = self.delims[closer].next
                } else {
                    let n = self.delims[closer].numdelims
                    closer = self.wrapDelims(opener, closer, NodeKind.Strike, n)
                }
            } else {
                var useDelims: i64 = 1
                if self.delims[closer].numdelims >= 2 && self.delims[opener].numdelims >= 2 {
                    useDelims = 2
                }
                var kind = NodeKind.Emph
                if useDelims == 2 {
                    kind = NodeKind.Strong
                }
                closer = self.wrapDelims(opener, closer, kind, useDelims)
            }

            if !openerFound {
                openersBottom[slot] = self.delims[oldCloser].prev
                if !self.delims[oldCloser].canOpen {
                    self.removeDelimiter(oldCloser)
                }
            }
        }

        while self.delimTop >= 0 && self.delimTop != stackBottom {
            let t = self.delimTop
            self.removeDelimiter(t)
        }
    }

    // Wrap everything between two delimiter runs in an emphasis node, consuming
    // `useDelims` characters from each. Returns the next closer to examine.
    fn wrapDelims(self: &mut Self, opener: i64, closer: i64, kind: NodeKind, useDelims: i64): i64 {
        let openerNode = self.delims[opener].node
        let closerNode = self.delims[closer].node
        self.delims[opener].numdelims = self.delims[opener].numdelims - useDelims
        self.delims[closer].numdelims = self.delims[closer].numdelims - useDelims

        let ol = self.nodes[openerNode].literal.clone()
        self.nodes[openerNode].literal = ol.substr(0, ol.len - useDelims)
        let cl = self.nodes[closerNode].literal.clone()
        self.nodes[closerNode].literal = cl.substr(0, cl.len - useDelims)

        let emph = self.addNode(kind)
        var tmp = self.nodes[openerNode].next
        while tmp >= 0 && tmp != closerNode {
            let nxt = self.nodes[tmp].next
            self.unlinkNode(tmp)
            self.appendChild(emph, tmp)
            tmp = nxt
        }
        self.insertAfter(openerNode, emph)
        self.removeDelimsBetween(opener, closer)

        if self.delims[opener].numdelims == 0 {
            self.unlinkNode(openerNode)
            self.removeDelimiter(opener)
        }
        if self.delims[closer].numdelims == 0 {
            self.unlinkNode(closerNode)
            let nxt = self.delims[closer].next
            self.removeDelimiter(closer)
            return nxt
        }
        return closer
    }

    // ── Links, images and reference definitions ──────────────────────────────

    fn addBracket(self: &mut Self, node: i64, index: i64, image: bool): void {
        if self.bracketTop >= 0 {
            self.brackets[self.bracketTop].bracketAfter = true
        }
        let id = self.brackets.len
        let top = self.bracketTop
        let dtop = self.delimTop
        self.brackets.push(Bracket {
            node: node, prev: top, prevDelim: dtop, index: index,
            image: image, active: true, bracketAfter: false,
        }
        )
        self.bracketTop = id
    }

    fn removeBracket(self: &mut Self): void {
        if self.bracketTop >= 0 {
            self.bracketTop = self.brackets[self.bracketTop].prev
        }
    }

    fn parseOpenBracket(self: &mut Self, block: i64): bool {
        let startpos = self.ipos
        self.ipos = self.ipos + 1
        let node = self.addText(block, "[")
        self.addBracket(node, startpos, false)
        return true
    }

    fn parseBang(self: &mut Self, block: i64): bool {
        let startpos = self.ipos
        self.ipos = self.ipos + 1
        if byteAt(self.subject, self.ipos) == '[' {
            self.ipos = self.ipos + 1
            let node = self.addText(block, "![")
            self.addBracket(node, startpos + 1, true)
            return true
        }
        self.addText(block, "!")
        return true
    }

    fn parseCloseBracket(self: &mut Self, block: i64): bool {
        self.ipos = self.ipos + 1
        let startpos = self.ipos
        let opener = self.bracketTop
        if opener < 0 {
            self.addText(block, "]")
            return true
        }
        if !self.brackets[opener].active {
            self.addText(block, "]")
            self.removeBracket()
            return true
        }
        let isImage = self.brackets[opener].image
        let savepos = self.ipos
        var matched = false
        var dest = ""
        var title = ""

        // inline link: `](dest "title")`
        if byteAt(self.subject, self.ipos) == '(' {
            self.ipos = self.ipos + 1
            self.spnl()
            let d = self.parseLinkDestination()
            if d.ok {
                let beforeSpnl = self.ipos
                self.spnl()
                if self.ipos > beforeSpnl {
                    // A title must be separated from the destination by
                    // whitespace, otherwise `(foo"bar")` would take a title.
                    let t = self.parseLinkTitle()
                    if t.ok {
                        title = t.value.clone()
                        self.spnl()
                    }
                }
                if byteAt(self.subject, self.ipos) == ')' {
                    self.ipos = self.ipos + 1
                    dest = d.value.clone()
                    matched = true
                }
            }
            if !matched {
                self.ipos = savepos
                title = ""
            }
        }

        // reference link: full `][label]`, collapsed `][]`, or shortcut `]`
        if !matched {
            let beforeLabel = self.ipos
            let n = self.parseLinkLabel()
            var reflabel = ""
            var haveLabel = false
            if n > 2 {
                reflabel = self.subject.substr(beforeLabel, beforeLabel + n)
                haveLabel = true
            } else if !self.brackets[opener].bracketAfter {
                let from = self.brackets[opener].index
                reflabel = self.subject.substr(from, startpos)
                haveLabel = true
            }
            if n == 0 {
                self.ipos = savepos
            }
            if haveLabel {
                let norm = normalizeReference(reflabel)
                match self.refKeys.get(norm) {
                    Option.Some(idx) => {
                        dest = self.refDest[idx].clone()
                        title = self.refTitle[idx].clone()
                        matched = true
                    }
                    Option.None => {
                    }
                }
            }
        }

        if !matched {
            self.removeBracket()
            self.ipos = startpos
            self.addText(block, "]")
            return true
        }

        var kind = NodeKind.Link
        if isImage {
            kind = NodeKind.Image
        }
        let node = self.addNode(kind)
        self.nodes[node].dest = dest
        self.nodes[node].title = title
        let openerNode = self.brackets[opener].node
        var tmp = self.nodes[openerNode].next
        while tmp >= 0 {
            let nxt = self.nodes[tmp].next
            self.unlinkNode(tmp)
            self.appendChild(node, tmp)
            tmp = nxt
        }
        self.appendChild(block, node)
        let bottom = self.brackets[opener].prevDelim
        self.processEmphasis(bottom)
        self.removeBracket()
        self.unlinkNode(openerNode)

        // Links may not nest: every earlier link opener is dead.
        if !isImage {
            var b = self.bracketTop
            while b >= 0 {
                if !self.brackets[b].image {
                    self.brackets[b].active = false
                }
                b = self.brackets[b].prev
            }
        }
        return true
    }

    // Optional spaces/tabs and at most one line ending.
    fn spnl(self: &mut Self): void {
        var seenNewline = false
        while self.ipos < self.subject.len {
            let c = self.subject[self.ipos]
            if c == ' ' || c == '\t' {
                self.ipos = self.ipos + 1
            } else if c == '\n' && !seenNewline {
                seenNewline = true
                self.ipos = self.ipos + 1
            } else {
                break
            }
        }
    }

    fn parseLinkDestination(self: &mut Self): StrResult {
        if byteAt(self.subject, self.ipos) == '<' {
            var i = self.ipos + 1
            while i < self.subject.len {
                let c = self.subject[i]
                if c == '>' {
                    let raw = self.subject.substr(self.ipos + 1, i)
                    self.ipos = i + 1
                    return StrResult {
                        ok: true, value: unescapeString(raw)
                    }
                }
                if c == '\n' || c == '<' {
                    return StrResult {
                        ok: false, value: ""
                    }
                }
                if c == '\\' && i + 1 < self.subject.len {
                    i = i + 2
                } else {
                    i = i + 1
                }
            }
            return StrResult {
                ok: false, value: ""
            }
        }
        let save = self.ipos
        var openParens: i64 = 0
        var i = self.ipos
        var stopByte: u8 = 0
        while i < self.subject.len {
            let c = self.subject[i]
            if c == '\\' && i + 1 < self.subject.len && isAsciiPunct(self.subject[i + 1]) {
                i = i + 2
                continue
            }
            if c == '(' {
                openParens = openParens + 1
                i = i + 1
                continue
            }
            if c == ')' {
                if openParens < 1 {
                    stopByte = c
                    break
                }
                openParens = openParens - 1
                i = i + 1
                continue
            }
            if c == ' ' || c == '\t' || c == '\n' || c == 11 || c == 12 || c == '\r' {
                stopByte = c
                break
            }
            i = i + 1
        }
        if i == save && stopByte != ')' {
            return StrResult {
                ok: false, value: ""
            }
        }
        if openParens != 0 {
            return StrResult {
                ok: false, value: ""
            }
        }
        let raw = self.subject.substr(save, i)
        self.ipos = i
        return StrResult {
            ok: true, value: unescapeString(raw)
        }
    }

    fn parseLinkTitle(self: &mut Self): StrResult {
        let q = byteAt(self.subject, self.ipos)
        var closer: u8 = 0
        if q == '"' {
            closer = '"'
        } else if q == '\'' {
            closer = '\''
        } else if q == '(' {
            closer = ')'
        } else {
            return StrResult {
                ok: false, value: ""
            }
        }
        var i = self.ipos + 1
        while i < self.subject.len {
            let c = self.subject[i]
            if c == '\\' && i + 1 < self.subject.len {
                i = i + 2
                continue
            }
            if c == closer {
                let raw = self.subject.substr(self.ipos + 1, i)
                self.ipos = i + 1
                return StrResult {
                    ok: true, value: unescapeString(raw)
                }
            }
            // An unescaped `(` may not appear inside a parenthesised title.
            if q == '(' && c == '(' {
                return StrResult {
                    ok: false, value: ""
                }
            }
            i = i + 1
        }
        return StrResult {
            ok: false, value: ""
        }
    }

    // Length of a `[...]` label at the cursor (brackets included), or 0. On a
    // match the cursor moves past the label — the caller rewinds when it turns
    // out not to want it.
    fn parseLinkLabel(self: &mut Self): i64 {
        if byteAt(self.subject, self.ipos) != '[' {
            return 0
        }
        var i = self.ipos + 1
        var count: i64 = 0
        while i < self.subject.len {
            let c = self.subject[i]
            if c == '\\' && i + 1 < self.subject.len {
                i = i + 2
                count = count + 2
                continue
            }
            if c == '[' {
                return 0
            }
            if c == ']' {
                if count > 999 {
                    return 0
                }
                let used = i + 1 - self.ipos
                self.ipos = i + 1
                return used
            }
            i = i + 1
            count = count + 1
        }
        return 0
    }

    // Parse one link reference definition off the front of `content`, returning
    // how many bytes it used (0 if there is not one there).
    fn parseReference(self: &mut Self, content: &string): i64 {
        self.subject = content.clone()
        self.ipos = 0
        let labelLen = self.parseLinkLabel()
        if labelLen == 0 {
            return 0
        }
        let rawlabel = self.subject.substr(0, labelLen)
        self.ipos = labelLen
        if byteAt(self.subject, self.ipos) != ':' {
            return 0
        }
        self.ipos = self.ipos + 1
        self.spnl()
        let d = self.parseLinkDestination()
        if !d.ok {
            return 0
        }
        let beforeTitle = self.ipos
        self.spnl()
        var title = ""
        var haveTitle = false
        if self.ipos != beforeTitle {
            let t = self.parseLinkTitle()
            if t.ok {
                title = t.value.clone()
                haveTitle = true
            }
        }
        if !haveTitle {
            self.ipos = beforeTitle
        }
        // The definition must end its line. If a title was found but something
        // follows it, the definition may still be legal without the title.
        var atLineEnd = self.skipToLineEnd()
        if !atLineEnd && haveTitle {
            title = ""
            self.ipos = beforeTitle
            atLineEnd = self.skipToLineEnd()
        }
        if !atLineEnd {
            return 0
        }
        let norm = normalizeReference(rawlabel)
        if norm.len == 0 {
            return 0
        }
        // First definition wins; a later one with the same label is ignored.
        if !self.refKeys.contains(norm) {
            let idx = self.refDest.len
            self.refDest.push(d.value.clone())
            self.refTitle.push(title.clone())
            self.refKeys.insert(norm.clone(), idx)
        }
        return self.ipos
    }

    // Consume trailing spaces plus one newline; false if anything else is left.
    fn skipToLineEnd(self: &mut Self): bool {
        var i = self.ipos
        while i < self.subject.len && (self.subject[i] == ' ' || self.subject[i] == '\t') {
            i = i + 1
        }
        if i >= self.subject.len {
            self.ipos = i
            return true
        }
        if self.subject[i] == '\n' {
            self.ipos = i + 1
            return true
        }
        return false
    }

    // ── GFM extended autolinks ───────────────────────────────────────────────

    // Bare URLs become links in a pass over the finished inline tree, not during
    // the inline scan. cmark-gfm does it the same way and for the same reason:
    // running it inline lets a URL swallow the `]` that closes the link label it
    // sits inside, and links cannot nest anyway.
    fn gfmAutolinkPass(self: &mut Self, parent: i64): void {
        var c = self.nodes[parent].firstChild
        while c >= 0 {
            let k = self.nodes[c].kind
            if isKind(k, NodeKind.Text) {
                // A URL can span several text nodes: the inline parser splits
                // text at every `_`, `~` or failed `&entity;`, and
                // `www.a.com/x_(y)` is one link to GFM, not three fragments.
                var last = c
                var buf = self.nodes[c].literal.clone()
                var n = self.nodes[c].next
                while n >= 0 && isKind(self.nodes[n].kind, NodeKind.Text) {
                    buf.pushStr(self.nodes[n].literal)
                    last = n
                    n = self.nodes[n].next
                }
                self.rewriteAutolinkRun(c, last, buf)
                c = n
            } else {
                if !isKind(k, NodeKind.Link) && !isKind(k, NodeKind.Image) && !isKind(k, NodeKind.Code) {
                    self.gfmAutolinkPass(c)
                }
                c = self.nodes[c].next
            }
        }
    }

    // Replace a run of text nodes whose combined text contains bare URLs with
    // the text/link sequence it should have been. Leaves the run alone when
    // there is no URL in it.
    fn rewriteAutolinkRun(self: &mut Self, first: i64, last: i64, buf: string): void {
        var anchor = last
        var lastEmit: i64 = 0
        var found = false
        var i: i64 = 0
        while i < buf.len {
            let c = buf[i]
            if (c == 'w' || c == 'W' || c == 'h' || c == 'H') && autolinkBoundary(buf, i) {
                let prefix = gfmAutolinkPrefix(buf, i)
                if prefix > 0 {
                    let end = gfmUrlEnd(buf, i)
                    let raw = buf.substr(i, end)
                    if end > i + prefix && gfmValidDomain(raw, prefix) {
                        if i > lastEmit {
                            let t = self.addNode(NodeKind.Text)
                            let between = buf.substr(lastEmit, i)
                            self.nodes[t].literal = between
                            self.insertAfter(anchor, t)
                            anchor = t
                        }
                        var dest = raw.clone()
                        if prefix == 4 {
                            // a bare `www.` link gets an http:// scheme
                            dest = "http://" + raw
                        }
                        let l = self.addNode(NodeKind.Link)
                        self.nodes[l].dest = dest
                        self.insertAfter(anchor, l)
                        anchor = l
                        let tx = self.addNode(NodeKind.Text)
                        self.nodes[tx].literal = raw.clone()
                        self.appendChild(l, tx)
                        found = true
                        lastEmit = end
                        i = end
                        continue
                    }
                }
            }
            i = i + 1
        }
        if !found {
            return
        }
        if lastEmit < buf.len {
            let t = self.addNode(NodeKind.Text)
            let tail = buf.substr(lastEmit, buf.len)
            self.nodes[t].literal = tail
            self.insertAfter(anchor, t)
        }
        // The originals are gone: their text is now spread across the new
        // nodes, so leaving any of them in would duplicate it.
        var old: Vec<i64> = Vec.new()
        var p = first
        var going = true
        while going {
            old.push(p)
            if p == last {
                going = false
            } else {
                p = self.nodes[p].next
            }
        }
        for j in 0..old.len {
            self.unlinkNode(old[j])
        }
    }

    // ── GFM tables ───────────────────────────────────────────────────────────
    //
    // A table starts when a one-line paragraph is followed by a delimiter row
    // with the same number of cells. Requiring the header to be the paragraph's
    // only line is a deliberate simplification of GFM, which splits a longer
    // paragraph at its last line; it costs a table that is glued to the
    // paragraph above it, which is not a shape anyone writes on purpose.

    fn tryTableStart(self: &mut Self, container: i64): bool {
        let content = self.nodes[container].content.clone()
        let header = content.trim()
        if header.len == 0 || header.contains("\n") || !header.contains("|") {
            return false
        }
        let rest = self.line.substr(self.nextNonspace, self.line.len)
        if !rest.contains("|") {
            return false
        }
        let aligns = parseDelimRow(rest)
        if aligns.len == 0 {
            return false
        }
        let cells = splitTableCells(header)
        if cells.len != aligns.len {
            return false
        }

        self.closeUnmatchedBlocks()
        let t = self.addNode(NodeKind.Table)
        self.nodes[t].level = aligns.len
        self.insertAfter(container, t)
        self.unlinkNode(container)
        self.tip = t

        let row = self.addNode(NodeKind.TableRow)
        self.nodes[row].isHeader = true
        // Rows and cells are finished the moment they are built; leaving them
        // open would make the next line's container walk descend into them.
        self.nodes[row].open = false
        self.appendChild(t, row)
        for i in 0..cells.len {
            let cell = self.addNode(NodeKind.TableCell)
            self.nodes[cell].isHeader = true
            self.nodes[cell].open = false
            self.nodes[cell].level = aligns[i]
            let text = cells[i].clone()
            self.nodes[cell].content = text
            self.appendChild(row, cell)
        }
        let remaining = self.line.len - self.pos
        self.advanceOffset(remaining, false)
        return true
    }

    fn tableLineEnds(self: &Self): bool {
        if self.indented {
            return false
        }
        let at = self.nextNonspace
        let c = byteAt(self.line, at)
        if c == '>' {
            return true
        }
        if scanAtxMarker(self.line, at) > 0 {
            return true
        }
        if scanCodeFence(self.line, at) > 0 {
            return true
        }
        if isThematicBreak(self.line, at) {
            return true
        }
        return false
    }

    fn finalizeTable(self: &mut Self, block: i64): void {
        let content = self.nodes[block].content.clone()
        self.nodes[block].content = ""
        let ncols = self.nodes[block].level
        var aligns: Vec<i64> = Vec.new()
        let hrow = self.nodes[block].firstChild
        if hrow >= 0 {
            var c = self.nodes[hrow].firstChild
            while c >= 0 {
                aligns.push(self.nodes[c].level)
                c = self.nodes[c].next
            }
        }
        let lines = mdSplitLines(content)
        for i in 0..lines.len {
            let raw = lines[i].clone()
            if isBlankStr(raw) {
                continue
            }
            let cells = splitTableCells(raw.trim())
            let row = self.addNode(NodeKind.TableRow)
            self.nodes[row].open = false
            self.appendChild(block, row)
            // A row is padded with empty cells or truncated to the header's
            // width, which is what GFM specifies.
            for j in 0..ncols {
                let cell = self.addNode(NodeKind.TableCell)
                self.nodes[cell].open = false
                if j < aligns.len {
                    self.nodes[cell].level = aligns[j]
                }
                if j < cells.len {
                    let text = cells[j].clone()
                    self.nodes[cell].content = text
                }
                self.appendChild(row, cell)
            }
        }
    }

    // ── GFM task list items ──────────────────────────────────────────────────
    //
    // Run after the block phase and before inlines: the marker is the first
    // thing in the item's first paragraph, and stripping it there keeps it out
    // of the inline parse (where `[ ]` would look like a link label).
    fn markTaskItems(self: &mut Self, node: i64): void {
        if isKind(self.nodes[node].kind, NodeKind.Item) {
            let p = self.nodes[node].firstChild
            if p >= 0 && isKind(self.nodes[p].kind, NodeKind.Paragraph) {
                let c = self.nodes[p].content.clone()
                if c.len >= 3 && c[0] == '[' && c[2] == ']' && (c[1] == ' ' || c[1] == 'x' || c[1] == 'X') {
                    let after = byteAt(c, 3)
                    if after == 0 || after == ' ' || after == '\t' || after == '\n' {
                        if c[1] == ' ' {
                            self.nodes[node].taskState = 1
                        } else {
                            self.nodes[node].taskState = 2
                        }
                        let rest = c.substr(3, c.len)
                        self.nodes[p].content = rest
                    }
                }
            }
        }
        var ch = self.nodes[node].firstChild
        while ch >= 0 {
            let nx = self.nodes[ch].next
            self.markTaskItems(ch)
            ch = nx
        }
    }
}

struct StrResult {
    ok: bool,
    value: string,
}

// Split one table row into trimmed cell texts. `\|` is a literal pipe (GFM
// makes the backslash the only way to get one, even inside a code span), and
// the optional leading and trailing pipes are not cell boundaries.
fn splitTableCells(line: &string): Vec<string> {
    var out: Vec<string> = Vec.new()
    let s = line.trim()
    var start: i64 = 0
    var end = s.len
    if end > 0 && s[0] == '|' {
        start = 1
    }
    if end > start && s[end - 1] == '|' {
        if !(end >= 2 && s[end - 2] == '\\') {
            end = end - 1
        }
    }
    var cur = ""
    var i = start
    while i < end {
        let c = s[i]
        if c == '\\' && i + 1 < end && s[i + 1] == '|' {
            cur.push('|')
            i = i + 2
            continue
        }
        if c == '\\' && i + 1 < end {
            cur.push(c)
            cur.push(s[i + 1])
            i = i + 2
            continue
        }
        if c == '|' {
            out.push(cur.trim())
            cur = ""
            i = i + 1
            continue
        }
        cur.push(c)
        i = i + 1
    }
    out.push(cur.trim())
    return out
}

// Column alignments for a delimiter row (`| --- | :-: |`), or an empty Vec if
// this is not one. 0 none, 1 left, 2 center, 3 right.
fn parseDelimRow(line: &string): Vec<i64> {
    var out: Vec<i64> = Vec.new()
    let cells = splitTableCells(line)
    if cells.len == 0 {
        return out
    }
    for i in 0..cells.len {
        let c = cells[i].clone()
        var j: i64 = 0
        var left = false
        var right = false
        if j < c.len && c[j] == ':' {
            left = true
            j = j + 1
        }
        var dashes: i64 = 0
        while j < c.len && c[j] == '-' {
            dashes = dashes + 1
            j = j + 1
        }
        if j < c.len && c[j] == ':' {
            right = true
            j = j + 1
        }
        if j != c.len || dashes == 0 {
            out.clear()
            return out
        }
        if left && right {
            out.push(2)
        } else if left {
            out.push(1)
        } else if right {
            out.push(3)
        } else {
            out.push(0)
        }
    }
    return out
}

// ── Autolink and entity scanners ─────────────────────────────────────────────

// Index of the closing `>` of an `<scheme:...>` autolink, or -1.
fn scanAutolinkUri(s: &string, at: i64): i64 {
    if byteAt(s, at) != '<' {
        return -1
    }
    var i = at + 1
    if !isAlphaByte(byteAt(s, i)) {
        return -1
    }
    var schemeLen: i64 = 0
    while i < s.len {
        let c = s[i]
        if isAlnumByte(c) || c == '+' || c == '.' || c == '-' {
            schemeLen = schemeLen + 1
            i = i + 1
        } else {
            break
        }
    }
    if schemeLen < 2 || schemeLen > 32 || byteAt(s, i) != ':' {
        return -1
    }
    i = i + 1
    while i < s.len {
        let c = s[i]
        if c == '>' {
            return i
        }
        if c <= ' ' || c == '<' {
            return -1
        }
        i = i + 1
    }
    return -1
}

// Index of the closing `>` of an `<user@host>` email autolink, or -1.
fn scanAutolinkEmail(s: &string, at: i64): i64 {
    if byteAt(s, at) != '<' {
        return -1
    }
    var i = at + 1
    var local: i64 = 0
    while i < s.len {
        let c = s[i]
        if isAlnumByte(c) || c == '.' || c == '!' || c == '#' || c == '$' || c == '%'
        || c == '&' || c == '\'' || c == '*' || c == '+' || c == '/' || c == '='
        || c == '?' || c == '^' || c == '_' || c == '`' || c == '{' || c == '|'
        || c == '}' || c == '~' || c == '-' {
            local = local + 1
            i = i + 1
        } else {
            break
        }
    }
    if local == 0 || byteAt(s, i) != '@' {
        return -1
    }
    i = i + 1
    var labels: i64 = 0
    while true {
        var len: i64 = 0
        if !isAlnumByte(byteAt(s, i)) {
            return -1
        }
        while i < s.len && (isAlnumByte(s[i]) || s[i] == '-') {
            len = len + 1
            i = i + 1
        }
        if len > 63 || s[i - 1] == '-' {
            return -1
        }
        labels = labels + 1
        if byteAt(s, i) == '.' {
            i = i + 1
            continue
        }
        break
    }
    if byteAt(s, i) != '>' || labels == 0 {
        return -1
    }
    return i
}

// A GFM autolink may only start at the beginning of a text run or after one of
// these — the rule that keeps `foo.www.example.com` from linking mid-word.
fn autolinkBoundary(s: &string, at: i64): bool {
    if at == 0 {
        return true
    }
    let p = s[at - 1]
    return p == ' ' || p == '\t' || p == '\n' || p == '*' || p == '_' || p == '~' || p == '('
}

// Length of the `www.`/`http://`/`https://` prefix of a GFM extended autolink
// at `at`, or 0.
fn gfmAutolinkPrefix(s: &string, at: i64): i64 {
    let rest = s[at..s.len]
    let lower = toLowerStr(rest)
    if lower.startsWith("www.") {
        return 4
    }
    if lower.startsWith("https://") {
        return 8
    }
    if lower.startsWith("http://") {
        return 7
    }
    return 0
}

// Where a GFM extended autolink ends: trailing punctuation, unbalanced closing
// parens and a trailing entity reference are not part of the link, because in
// running text they are nearly always the sentence's punctuation.
fn gfmUrlEnd(s: &string, start: i64): i64 {
    var i = start
    while i < s.len {
        let c = s[i]
        if c == ' ' || c == '\t' || c == '\n' || c == '<' {
            break
        }
        i = i + 1
    }
    var going = true
    while going && i > start {
        let c = s[i - 1]
        if c == '?' || c == '!' || c == '.' || c == ',' || c == ':' || c == '*'
        || c == '_' || c == '~' || c == '\'' || c == '"' {
            i = i - 1
        } else if c == ')' {
            var opens: i64 = 0
            var closes: i64 = 0
            for j in start..i {
                if s[j] == '(' {
                    opens = opens + 1
                } else if s[j] == ')' {
                    closes = closes + 1
                }
            }
            if closes > opens {
                i = i - 1
            } else {
                going = false
            }
        } else if c == ';' {
            var j = i - 1
            while j > start && isAlnumByte(s[j - 1]) {
                j = j - 1
            }
            if j > start && s[j - 1] == '&' {
                i = j - 1
            } else {
                going = false
            }
        } else {
            going = false
        }
    }
    return i
}

// A GFM autolink's domain must have a dot and a non-empty last label.
fn gfmValidDomain(url: &string, prefixLen: i64): bool {
    var i = prefixLen
    var dots: i64 = 0
    var lastLabel: i64 = 0
    while i < url.len {
        let c = url[i]
        if c == '/' || c == '?' || c == '#' {
            break
        }
        if c == '.' {
            dots = dots + 1
            lastLabel = 0
        } else if c == ' ' {
            return false
        } else {
            lastLabel = lastLabel + 1
        }
        i = i + 1
    }
    return dots > 0 && lastLabel > 0
}

// Index just past an `&name;` / `&#123;` / `&#x1F;` reference at `at`, or -1.
fn scanEntity(s: &string, at: i64): i64 {
    if byteAt(s, at) != '&' {
        return -1
    }
    var i = at + 1
    if byteAt(s, i) == '#' {
        i = i + 1
        var digits: i64 = 0
        if byteAt(s, i) == 'x' || byteAt(s, i) == 'X' {
            i = i + 1
            while i < s.len && isHexByte(s[i]) && digits < 7 {
                digits = digits + 1
                i = i + 1
            }
            if digits == 0 || digits > 6 {
                return -1
            }
        } else {
            while i < s.len && isDigitByte(s[i]) && digits < 8 {
                digits = digits + 1
                i = i + 1
            }
            if digits == 0 || digits > 7 {
                return -1
            }
        }
        if byteAt(s, i) != ';' {
            return -1
        }
        return i + 1
    }
    if !isAlphaByte(byteAt(s, i)) {
        return -1
    }
    var n: i64 = 0
    while i < s.len && isAlnumByte(s[i]) && n < 33 {
        n = n + 1
        i = i + 1
    }
    if n < 2 || n > 32 || byteAt(s, i) != ';' {
        return -1
    }
    return i + 1
}

// ── Escapes, entities and reference labels ───────────────────────────────────

fn hexVal(c: u8): i64 {
    if c >= '0' && c <= '9' {
        return (c - '0') as i64
    }
    if c >= 'a' && c <= 'f' {
        return (c - 'a') as i64 + 10
    }
    if c >= 'A' && c <= 'F' {
        return (c - 'A') as i64 + 10
    }
    return -1
}

// Resolve backslash escapes and character references — what a link destination,
// a title and a code fence's info string all go through before they are stored.
fn unescapeString(s: &string): string {
    var out = ""
    var i: i64 = 0
    while i < s.len {
        let c = s[i]
        if c == '\\' && i + 1 < s.len && isAsciiPunct(s[i + 1]) {
            out.push(s[i + 1])
            i = i + 2
            continue
        }
        if c == '&' {
            let e = scanEntity(s, i)
            if e > 0 {
                let raw = s.substr(i, e)
                let dec = decodeEntityRef(raw)
                out.pushStr(dec)
                i = e
                continue
            }
        }
        out.push(c)
        i = i + 1
    }
    return out
}

// Decode one `&...;` reference. An unknown name decodes to itself, which is
// what makes `&MadeUpEntity;` survive into the output as literal text.
fn decodeEntityRef(raw: &string): string {
    if raw.len >= 4 && raw[1] == '#' {
        var value: i64 = 0
        var i: i64 = 2
        var radix: i64 = 10
        if raw[2] == 'x' || raw[2] == 'X' {
            radix = 16
            i = 3
        }
        while i < raw.len - 1 {
            let d = hexVal(raw[i])
            if d < 0 || d >= radix {
                break
            }
            // Saturate: the text is untrusted and anything past the Unicode
            // range is invalid however far past it goes.
            if value <= 1114111 {
                value = value * radix + d
            }
            i = i + 1
        }
        // NUL, surrogates and out-of-range values all become U+FFFD: emitting
        // them would produce bytes that are not valid UTF-8, or a NUL that
        // truncates the string wherever it is next written.
        if value == 0 || value > 1114111 || (value >= 55296 && value <= 57343) {
            value = 65533
        }
        var out = ""
        encodeCodepoint(out, value as i32)
        return out
    }
    let name = raw.substr(1, raw.len - 1)
    let v = namedEntityValue(name)
    if v.len > 0 {
        return v
    }
    return raw.clone()
}

fn namedEntityValue(name: &string): string {
    let key = "\n" + name + " "
    let data = entityData()
    match data.indexOf(key) {
        Option.Some(at) => {
            var out = ""
            var i = at + key.len
            var cp: i64 = 0
            var have = false
            while i < data.len {
                let c = data[i]
                if c == '\n' {
                    break
                }
                if c == ' ' {
                    if have {
                        encodeCodepoint(out, cp as i32)
                    }
                    cp = 0
                    have = false
                    i = i + 1
                    continue
                }
                cp = cp * 16 + hexVal(c)
                have = true
                i = i + 1
            }
            if have {
                encodeCodepoint(out, cp as i32)
            }
            return out
        }
        Option.None => {
            return ""
        }
    }
}

// Case-fold one codepoint into `out`. This is the alphabetic core of Unicode
// case folding — ASCII, Latin-1, Latin Extended-A, Greek and Cyrillic, plus the
// two sharp s forms that fold to "ss" — not the full case-folding table. A
// codepoint outside those ranges folds to itself, which for a script without
// case is the right answer anyway.
fn foldCaseCp(out: &mut string, cp: i32): void {
    if cp < 128 {
        if cp >= 65 && cp <= 90 {
            out.push((cp + 32) as u8)
        } else {
            out.push(cp as u8)
        }
        return
    }
    // ß and ẞ both fold to "ss", which is why `[ẞ]` and `[SS]` are one label.
    if cp == 223 || cp == 7838 {
        out.pushStr("ss")
        return
    }
    var folded = cp
    if cp >= 192 && cp <= 222 && cp != 215 {
        folded = cp + 32
    } else if (cp >= 256 && cp <= 311) || (cp >= 330 && cp <= 375) {
        if cp % 2 == 0 {
            folded = cp + 1
        }
    } else if (cp >= 313 && cp <= 328) || (cp >= 377 && cp <= 382) {
        if cp % 2 == 1 {
            folded = cp + 1
        }
    } else if cp >= 913 && cp <= 929 {
        folded = cp + 32
    } else if cp >= 931 && cp <= 939 {
        folded = cp + 32
    } else if cp >= 1040 && cp <= 1071 {
        folded = cp + 32
    } else if cp >= 1024 && cp <= 1039 {
        folded = cp + 80
    }
    encodeCodepoint(out, folded)
}

// A reference label matches with runs of whitespace collapsed and case folded.
fn normalizeReference(label: &string): string {
    if label.len < 2 {
        return ""
    }
    let inner = label.substr(1, label.len - 1)
    let trimmed = inner.trim()
    var out = ""
    var prevSpace = false
    for cp in trimmed.codePoints() {
        if cp == 32 || cp == 9 || cp == 10 || cp == 13 {
            if !prevSpace {
                out.push(' ')
                prevSpace = true
            }
        } else {
            foldCaseCp(out, cp)
            prevSpace = false
        }
    }
    return out
}

// ── HTML rendering ───────────────────────────────────────────────────────────
//
// A fold over the tree, matching cmark's output byte for byte where the spec
// pins it. `cr` is cmark's newline rule: end the current line if it has any
// content, which is what keeps block tags on their own lines without emitting
// blank ones.

fn cr(out: &mut string): void {
    if out.len > 0 && out[out.len - 1] != '\n' {
        out.push('\n')
    }
}

impl Markdown {
    // Render the whole document to HTML.
    fn toHtml(self: &Self): string {
        var out = ""
        self.renderChildren(self.root, out, false)
        return out
    }

    fn renderChildren(self: &Self, node: i64, out: &mut string, tight: bool): void {
        var i: i64 = 0
        let n = self.nodes[node].childCount
        while i < n {
            let c = self.childIdx[self.nodes[node].childStart + i]
            self.renderNode(c, out, tight)
            i = i + 1
        }
    }

    fn renderNode(self: &Self, node: i64, out: &mut string, tight: bool): void {
        let k = self.nodes[node].kind

        if isKind(k, NodeKind.Document) {
            self.renderChildren(node, out, false)
            return
        }
        if isKind(k, NodeKind.Paragraph) {
            if tight {
                self.renderChildren(node, out, false)
                return
            }
            cr(out)
            out.pushStr("<p>")
            self.renderChildren(node, out, false)
            out.pushStr("</p>\n")
            return
        }
        if isKind(k, NodeKind.Heading) {
            cr(out)
            let lvl = self.nodes[node].level
            out.pushStr("<h")
            out.push(('0' as i64 + lvl) as u8)
            out.push('>')
            self.renderChildren(node, out, false)
            out.pushStr("</h")
            out.push(('0' as i64 + lvl) as u8)
            out.pushStr(">\n")
            return
        }
        if isKind(k, NodeKind.ThematicBreak) {
            cr(out)
            out.pushStr("<hr />\n")
            return
        }
        if isKind(k, NodeKind.BlockQuote) {
            cr(out)
            out.pushStr("<blockquote>\n")
            self.renderChildren(node, out, false)
            cr(out)
            out.pushStr("</blockquote>\n")
            return
        }
        if isKind(k, NodeKind.List) {
            cr(out)
            let isTight = self.nodes[node].listTight
            if self.nodes[node].listOrdered {
                out.pushStr("<ol")
                let start = self.nodes[node].level
                if start != 1 {
                    out.pushStr(" start=\"")
                    out.pushStr(i64ToStr(start))
                    out.push('"')
                }
                out.pushStr(">\n")
                self.renderChildren(node, out, isTight)
                cr(out)
                out.pushStr("</ol>\n")
            } else {
                out.pushStr("<ul>\n")
                self.renderChildren(node, out, isTight)
                cr(out)
                out.pushStr("</ul>\n")
            }
            return
        }
        if isKind(k, NodeKind.Item) {
            cr(out)
            out.pushStr("<li>")
            if self.nodes[node].taskState != 0 {
                // GFM renders the checkbox as a disabled input before the
                // item's content.
                if self.nodes[node].taskState == 2 {
                    out.pushStr("<input type=\"checkbox\" checked=\"\" disabled=\"\" /> ")
                } else {
                    out.pushStr("<input type=\"checkbox\" disabled=\"\" /> ")
                }
            }
            self.renderChildren(node, out, tight)
            out.pushStr("</li>\n")
            return
        }
        if isKind(k, NodeKind.CodeBlock) {
            cr(out)
            out.pushStr("<pre><code")
            let info = self.nodes[node].dest.clone()
            if info.len > 0 {
                // Only the first word of the info string becomes the class.
                var end: i64 = 0
                while end < info.len && info[end] != ' ' && info[end] != '\t' {
                    end = end + 1
                }
                let lang = info.substr(0, end)
                out.pushStr(" class=\"language-")
                escapeHtmlInto(lang, out)
                out.push('"')
            }
            out.push('>')
            escapeHtmlInto(self.nodes[node].literal, out)
            out.pushStr("</code></pre>\n")
            return
        }
        if isKind(k, NodeKind.HtmlBlock) {
            cr(out)
            out.pushStr(self.nodes[node].literal)
            cr(out)
            return
        }
        if isKind(k, NodeKind.Text) {
            escapeHtmlInto(self.nodes[node].literal, out)
            return
        }
        if isKind(k, NodeKind.SoftBreak) {
            out.push('\n')
            return
        }
        if isKind(k, NodeKind.LineBreak) {
            out.pushStr("<br />\n")
            return
        }
        if isKind(k, NodeKind.Code) {
            out.pushStr("<code>")
            escapeHtmlInto(self.nodes[node].literal, out)
            out.pushStr("</code>")
            return
        }
        if isKind(k, NodeKind.HtmlInline) {
            out.pushStr(self.nodes[node].literal)
            return
        }
        if isKind(k, NodeKind.Emph) {
            out.pushStr("<em>")
            self.renderChildren(node, out, false)
            out.pushStr("</em>")
            return
        }
        if isKind(k, NodeKind.Strong) {
            out.pushStr("<strong>")
            self.renderChildren(node, out, false)
            out.pushStr("</strong>")
            return
        }
        if isKind(k, NodeKind.Strike) {
            out.pushStr("<del>")
            self.renderChildren(node, out, false)
            out.pushStr("</del>")
            return
        }
        if isKind(k, NodeKind.Link) {
            out.pushStr("<a href=\"")
            escapeHref(self.nodes[node].dest, out)
            out.push('"')
            if self.nodes[node].title.len > 0 {
                out.pushStr(" title=\"")
                escapeHtmlInto(self.nodes[node].title, out)
                out.push('"')
            }
            out.push('>')
            self.renderChildren(node, out, false)
            out.pushStr("</a>")
            return
        }
        if isKind(k, NodeKind.Image) {
            out.pushStr("<img src=\"")
            escapeHref(self.nodes[node].dest, out)
            out.pushStr("\" alt=\"")
            let alt = self.innerText(node)
            escapeHtmlInto(alt, out)
            out.push('"')
            if self.nodes[node].title.len > 0 {
                out.pushStr(" title=\"")
                escapeHtmlInto(self.nodes[node].title, out)
                out.push('"')
            }
            out.pushStr(" />")
            return
        }
        if isKind(k, NodeKind.Table) {
            cr(out)
            out.pushStr("<table>\n")
            let n = self.nodes[node].childCount
            var i: i64 = 0
            var inBody = false
            while i < n {
                let row = self.childIdx[self.nodes[node].childStart + i]
                if self.nodes[row].isHeader {
                    out.pushStr("<thead>\n")
                    self.renderNode(row, out, false)
                    out.pushStr("</thead>\n")
                } else {
                    if !inBody {
                        out.pushStr("<tbody>\n")
                        inBody = true
                    }
                    self.renderNode(row, out, false)
                }
                i = i + 1
            }
            if inBody {
                out.pushStr("</tbody>\n")
            }
            out.pushStr("</table>\n")
            return
        }
        if isKind(k, NodeKind.TableRow) {
            out.pushStr("<tr>\n")
            self.renderChildren(node, out, false)
            out.pushStr("</tr>\n")
            return
        }
        if isKind(k, NodeKind.TableCell) {
            var tag = "td"
            if self.nodes[node].isHeader {
                tag = "th"
            }
            out.push('<')
            out.pushStr(tag)
            let a = self.nodes[node].level
            if a == 1 {
                out.pushStr(" align=\"left\"")
            } else if a == 2 {
                out.pushStr(" align=\"center\"")
            } else if a == 3 {
                out.pushStr(" align=\"right\"")
            }
            out.push('>')
            self.renderChildren(node, out, false)
            out.pushStr("</")
            out.pushStr(tag)
            out.pushStr(">\n")
            return
        }
    }
}

fn i64ToStr(v: i64): string {
    if v == 0 {
        return "0"
    }
    var n = v
    var neg = false
    if n < 0 {
        neg = true
        n = -n
    }
    var digits = ""
    while n > 0 {
        digits.push(('0' as i64 + (n % 10)) as u8)
        n = n / 10
    }
    var out = ""
    if neg {
        out.push('-')
    }
    var i = digits.len
    while i > 0 {
        out.push(digits[i - 1])
        i = i - 1
    }
    return out
}

// The HTML5 named character reference table, as `name cp[ cp]` records: the
// spec requires every one of these to be recognised in `&name;` form. It is
// stored as text and parsed into a map on first use, so a document with no
// entity references never pays for it.
